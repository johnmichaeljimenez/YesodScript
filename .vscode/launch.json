{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Raylib Example (External Terminal)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/YesodScript.Examples.Raylib/bin/Debug/net8.0/Pong.dll",
			"args": [
				"--game",
				"jrpg"
			],
			"cwd": "${workspaceFolder}/YesodScript.Examples.Raylib",
			"console": "externalTerminal",
			"stopAtEntry": false
		}
	]
}