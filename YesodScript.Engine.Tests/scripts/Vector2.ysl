@_INIT

DEFVAR P 3,4 vector2
PRINT "[[P]]"

SETVAR P 1,2
PRINT "[[P]]"

SETVAR P 1,0 true
PRINT "[[P]]"

DEFVAR Q 2,3 vector2
ADD P Q
PRINT "[[P]]"

SUB P 1,1
PRINT "[[P]]"

DEFVAR L 0 float
DEFVAR LS 0 float
DEFVAR V 3,4 vector2
VLENGTH V L
VLENGTHSQUARED V LS
PRINT "[[L]]"
PRINT "[[LS]]"

DEFVAR S 16 float
SQRT S
PRINT "[[S]]"

DEFVAR N 3,4 vector2
VNORMALIZE N
PRINT "[[N]]"

DEFVAR SC 2,3 vector2
VSCALE SC 2.5
PRINT "[[SC]]"

DEFVAR A 1,0 vector2
DEFVAR B 0,1 vector2
DEFVAR D 0 float
VDOT A B D
PRINT "[[D]]"

DEFVAR NEAR 0,0 vector2
DEFVAR FAR 10,0 vector2
DEFVAR OTHER 3,4 vector2
JUMPDISTANCE NEAR OTHER 5 WITHIN
PRINT "MISS"
JUMP DONE

> WITHIN
    PRINT "HIT"
    JUMPDISTANCE NEAR FAR 5 SHOULD_MISS
    PRINT "OK"
    JUMP DONE

> SHOULD_MISS
    PRINT "BAD"

> DONE
    BREAK