@_INIT

DEFVAR PX 3 float
DEFVAR PY 4 float
PRINT "[[PX]],[[PY]]"

SETVAR PX 1
SETVAR PY 2
PRINT "[[PX]],[[PY]]"

SETVAR PX 1 true
SETVAR PY 0 true
PRINT "[[PX]],[[PY]]"

DEFVAR QX 2 float
DEFVAR QY 3 float
$VADD PX PY [[QX]] [[QY]]
PRINT "[[PX]],[[PY]]"

$VSUB PX PY 1 1
PRINT "[[PX]],[[PY]]"

DEFVAR L 0 float
DEFVAR LS 0 float
DEFVAR VX 3 float
DEFVAR VY 4 float
$VLENGTH [[VX]] [[VY]] L
$VLENGTHSQUARED [[VX]] [[VY]] LS
PRINT "[[L]]"
PRINT "[[LS]]"

DEFVAR S 16 float
SQRT S
PRINT "[[S]]"

DEFVAR NX 3 float
DEFVAR NY 4 float
$VNORMALIZE NX NY
PRINT "[[NX]],[[NY]]"

DEFVAR SCX 2 float
DEFVAR SCY 3 float
$VSCALE SCX SCY 2.5
PRINT "[[SCX]],[[SCY]]"

DEFVAR AX 1 float
DEFVAR AY 0 float
DEFVAR BX 0 float
DEFVAR BY 1 float
DEFVAR D 0 float
$VDOT [[AX]] [[AY]] [[BX]] [[BY]] D
PRINT "[[D]]"

DEFVAR GX 0 float
DEFVAR GY 0 float
SETVAR GX [[NX]]
SETVAR GY [[NY]]
PRINT "[[GX]]"
PRINT "[[GY]]"

DEFVAR NEARX 0 float
DEFVAR NEARY 0 float
DEFVAR FARX 10 float
DEFVAR FARY 0 float
DEFVAR OTHERX 3 float
DEFVAR OTHERY 4 float
DEFVAR HIT false bool

$VINRANGE [[NEARX]] [[NEARY]] [[OTHERX]] [[OTHERY]] 5 HIT
JUMPEQ HIT true WITHIN
PRINT "MISS"
JUMP DONE

> WITHIN
	PRINT "HIT"
	$VINRANGE [[NEARX]] [[NEARY]] [[FARX]] [[FARY]] 5 HIT
	JUMPEQ HIT true SHOULD_MISS
	PRINT "OK"
	JUMP DONE

> SHOULD_MISS
	PRINT "BAD"

> DONE
	BREAK
