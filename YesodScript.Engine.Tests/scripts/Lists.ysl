@_INIT
DEFLIST ITEMS string
LISTADD ITEMS "apple"
LISTADD ITEMS "banana"
LISTADD ITEMS "cherry"

DEFLIST NUMBERS int
DEFVAR _SIZE 0 int
DEFVAR _CTR 0 int
DEFVAR _CURRENT "none" string
DEFVAR _I 0 int
DEFVAR _N 0 int
DEFVAR _VAL 0 int
DEFVAR _SUM 0 int
DEFVAR _FOUND 0 int

LISTCOUNT ITEMS _SIZE
> LOOP
	JUMPGE _CTR [[_SIZE]] STR_DONE
	LISTGET ITEMS [[_CTR]] _CURRENT
	PRINT [[_CURRENT]]

	ADD _CTR 1
	JUMP LOOP

> STR_DONE
	LISTADD NUMBERS 10
	LISTADD NUMBERS 20
	LISTADD NUMBERS 30
	LISTSET NUMBERS 1 25
	LISTINSERT NUMBERS 0 5
	LISTREMOVE NUMBERS -1

		# bare local var as list value
		DEFVAR _AMT 40 int
		LISTSET NUMBERS 2 _AMT

		LISTCOUNT NUMBERS _N
	> INT_LOOP
		JUMPGE _I [[_N]] INT_SUM
		LISTGET NUMBERS [[_I]] _VAL
		PRINT [[_VAL]]
		ADD _SUM [[_VAL]]

		ADD _I 1
		JUMP INT_LOOP

	> INT_SUM
		PRINT "SUM: [[_SUM]]"

		LISTFIND ITEMS "banana" _FOUND
	PRINT [[_FOUND]]
		LISTFIND ITEMS "missing" _FOUND
		PRINT [[_FOUND]]
		LISTFIND NUMBERS 40 _FOUND
		PRINT [[_FOUND]]
		BREAK