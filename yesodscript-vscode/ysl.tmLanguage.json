{
  "name": "YesodScript.Engine",
  "scopeName": "source.ysl",
  "fileTypes": ["ysl"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#trigger" },
    { "include": "#label" },
    { "include": "#callShorthand" },
    { "include": "#string" },
    { "include": "#interpolation" },
    { "include": "#parameter" },
    { "include": "#defaultArg" },
    { "include": "#command" },
    { "include": "#type" },
    { "include": "#boolean" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.ysl",
      "match": "#.*$"
    },
    "trigger": {
      "match": "^\\s*(@)(\\S+)",
      "captures": {
        "1": { "name": "punctuation.definition.trigger.ysl" },
        "2": { "name": "entity.name.function.trigger.ysl" }
      }
    },
    "label": {
      "match": "^\\s*(>)\\s*(\\S+)",
      "captures": {
        "1": { "name": "keyword.control.label.ysl" },
        "2": { "name": "entity.name.label.ysl" }
      }
    },
    "callShorthand": {
      "match": "^\\s*(\\$)(\\S*)",
      "captures": {
        "1": { "name": "keyword.control.command.ysl" },
        "2": { "name": "entity.name.function.trigger.ysl" }
      }
    },
    "string": {
      "name": "string.quoted.double.ysl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#parameter" }
      ]
    },
    "interpolation": {
      "name": "variable.other.interpolated.ysl",
      "begin": "\\[\\[",
      "end": "\\]\\]"
    },
    "parameter": {
      "name": "variable.parameter.ysl",
      "match": "<[^<>]+>"
    },
    "defaultArg": {
      "match": "(^|[\\t ])(\\*)(?=[\\t ]|$)",
      "captures": {
        "2": { "name": "constant.language.default.ysl" }
      }
    },
    "command": {
      "match": "^\\s*(?![@#>:])([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.control.command.ysl" }
      }
    },
    "type": {
      "name": "storage.type.ysl",
      "match": "(?i)(?<=\\s)\\b(int|float|string|bool|vector2)\\b"
    },
    "boolean": {
      "name": "constant.language.boolean.ysl",
      "match": "(?i)\\b(true|false)\\b"
    },
    "number": {
      "match": "\\b-?\\d+(?:\\.\\d+)?\\b",
      "name": "constant.numeric.ysl"
    }
  }
}
