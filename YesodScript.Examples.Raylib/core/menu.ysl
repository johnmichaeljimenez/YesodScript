@MENU <list> <result>
	DEFVAR _sel 0 int
	DEFVAR _count 0 int
	DEFVAR _i 0 int
	DEFVAR _id 0 int
	DEFVAR _y 0 int
	DEFVAR _startY 0 int
	DEFVAR _line 28 int
	DEFVAR _label * string
	DEFLIST _ids int

	LISTCOUNT <list> _count
	JUMPLE _count 0 MENU_LIST_ABORT

	SETVAR _startY 180
	SETVAR _i [[_count]]
	MUL _i [[_line]]
	DIV _i 2
	SUB _startY [[_i]]
	SETVAR _y [[_startY]]
	SETVAR _i 0

	>MENU_LIST_BUILD
		JUMPGE _i [[_count]] MENU_LIST_BUILT

		LISTGET <list> [[_i]] _label
		RENDER 320 [[_y]] _id 100 "MENU"
		EDIT [[_id]] "Text" [[_label]]
		EDIT [[_id]] "FontSize" 18
		EDIT [[_id]] "TextHAlign" 0
		EDIT [[_id]] "TextVAlign" 0
		LISTADD _ids [[_id]]
		ADD _y [[_line]]
		ADD _i 1
		JUMP MENU_LIST_BUILD

	>MENU_LIST_BUILT
		JUMP MENU_LIST_REFRESH

	>MENU_LIST_REFRESH
		SETVAR _i 0

	>MENU_LIST_COLOR_LOOP
		JUMPGE _i [[_count]] MENU_LIST_INPUT
		LISTGET _ids [[_i]] _id
		JUMPEQ _i [[_sel]] MENU_LIST_COLOR_SEL

		EDIT [[_id]] "Tint.R" 140
		EDIT [[_id]] "Tint.G" 140
		EDIT [[_id]] "Tint.B" 140
		JUMP MENU_LIST_COLOR_NEXT

	>MENU_LIST_COLOR_SEL
		EDIT [[_id]] "Tint.R" 255
		EDIT [[_id]] "Tint.G" 220
		EDIT [[_id]] "Tint.B" 64

	>MENU_LIST_COLOR_NEXT
		ADD _i 1
		JUMP MENU_LIST_COLOR_LOOP

	>MENU_LIST_INPUT
		JUMPKEYPRESS "W" MENU_LIST_UP
		JUMPKEYPRESS "S" MENU_LIST_DOWN
		JUMPKEYPRESS "Space" MENU_LIST_CHOOSE

		WAITFRAME
		JUMP MENU_LIST_INPUT

	>MENU_LIST_UP
		SUB _sel 1
		JUMPGE _sel 0 MENU_LIST_REFRESH
		SETVAR _sel [[_count]]
		SUB _sel 1
		JUMP MENU_LIST_REFRESH

	>MENU_LIST_DOWN
		ADD _sel 1
		JUMPLT _sel [[_count]] MENU_LIST_REFRESH
		SETVAR _sel 0
		JUMP MENU_LIST_REFRESH

	>MENU_LIST_CHOOSE
		SETVAR <result> [[_sel]]
		JUMP MENU_LIST_CLEANUP

	>MENU_LIST_CLEANUP
		SETVAR _i 0

	>MENU_LIST_CLEAN_LOOP
		JUMPGE _i [[_count]] MENU_LIST_DONE
		LISTGET _ids [[_i]] _id
		REMOVERENDER [[_id]]
		ADD _i 1
		JUMP MENU_LIST_CLEAN_LOOP

	>MENU_LIST_DONE
		BREAK

	>MENU_LIST_ABORT
		SETVAR <result> -1
		BREAK
