<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- select game content pack. override with GameId msbuild property -->
    <GameId Condition="'$(GameId)' == ''">pong</GameId>
    <GameTitle Condition="'$(GameTitle)' == ''">Pong</GameTitle>
    <GameIcon Condition="'$(GameIcon)' == ''">game/$(GameId)/$(GameTitle).ico</GameIcon>

    <AssemblyName>$(GameTitle)</AssemblyName>
    <Product>$(GameTitle)</Product>
    <AssemblyTitle>$(GameTitle)</AssemblyTitle>
    <ApplicationIcon Condition="Exists('$(GameIcon)')">$(GameIcon)</ApplicationIcon>
  </PropertyGroup>

  <!-- itch.io stuff -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputType>WinExe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YesodScript.Runtime.Raylib\YesodScript.Runtime.Raylib.csproj" />
  </ItemGroup>

  <!-- Debug: ship all sample games under game/ for multi-game switching. -->
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <None Include="game/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Release: flatten one game pack next to the exe (runtime assumes one game). -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Include="game/$(GameId)/assets/**/*">
      <Link>assets/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="game/$(GameId)/scripts/**/*">
      <Link>scripts/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="game/$(GameId)/game.json" Condition="Exists('game/$(GameId)/game.json')">
      <Link>game.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateGameContent" BeforeTargets="Build">
    <Error
      Condition="!Exists('game/$(GameId)/scripts') and !Exists('game/$(GameId)/assets')"
      Text="Game content not found for GameId=$(GameId). Expected game/$(GameId)/scripts and/or assets." />
  </Target>

</Project>