@GAME_INIT
    DEFVAR "MENU_TITLE" 0 int
    DEFVAR "MENU_BUTTON1" 0 int
    DEFVAR "MENU_BUTTON2" 0 int
    
    RENDER 320 140 "MENU_TITLE" 20 "POPUP_MENU"
    EDIT [[MENU_TITLE]] "FontSize" 60
    EDIT [[MENU_TITLE]] "Text" "PONG"
    
    RENDER 320 250 "MENU_BUTTON1" 20 "POPUP_MENU"
    EDIT [[MENU_BUTTON1]] "FontSize" 15
    EDIT [[MENU_BUTTON1]] "Text" "[1] 1 Player"
    
    RENDER 320 280 "MENU_BUTTON2" 20 "POPUP_MENU"
    EDIT [[MENU_BUTTON2]] "FontSize" 15
    EDIT [[MENU_BUTTON2]] "Text" "[2] 2 Players"

    DEFVAR "PAUSE_TITLE" 0 int
    DEFVAR "PAUSE_RESUME" 0 int
    DEFVAR "PAUSE_EXIT" 0 int
    
    RENDER 320 140 "PAUSE_TITLE" 20 "POPUP_PAUSE"
    EDIT [[PAUSE_TITLE]] "FontSize" 40
    EDIT [[PAUSE_TITLE]] "Text" "Game Paused"
    
    RENDER 320 250 "PAUSE_RESUME" 20 "POPUP_PAUSE"
    EDIT [[PAUSE_RESUME]] "FontSize" 15
    EDIT [[PAUSE_RESUME]] "Text" "[Esc] Resume"
    
    RENDER 320 280 "PAUSE_EXIT" 20 "POPUP_PAUSE"
    EDIT [[PAUSE_EXIT]] "FontSize" 15
    EDIT [[PAUSE_EXIT]] "Text" "[Enter] Quit to Menu"

    DEFVAR "TXTSERVE" 0 int
    RENDER 320 340 "TXTSERVE" 20 "POPUP_SERVE"
    EDIT [[TXTSERVE]] "FontSize" 15
    EDIT [[TXTSERVE]] "Text" "[Space] Begin!"
    
    
    DEFVAR "TXTSCORE1" 0 int
    RENDER 160 30 "TXTSCORE1" 1
    EDIT [[TXTSCORE1]] "Text" 0
    EDIT [[TXTSCORE1]] "FontSize" 40
    EDIT [[TXTSCORE1]] "Tint.R" 0
    EDIT [[TXTSCORE1]] "Tint.G" 255
    EDIT [[TXTSCORE1]] "Tint.B" 255

    DEFVAR "TXTSCORE2" 0 int
    RENDER 480 30 "TXTSCORE2" 1
    EDIT [[TXTSCORE2]] "Text" 0
    EDIT [[TXTSCORE2]] "FontSize" 40
    EDIT [[TXTSCORE2]] "Tint.R" 255
    EDIT [[TXTSCORE2]] "Tint.G" 0
    EDIT [[TXTSCORE2]] "Tint.B" 0

    DEFVAR "TXTWINNER" 0 int
    RENDER 320 180 "TXTWINNER" 10 "POPUP_SCORE"
    EDIT [[TXTWINNER]] "FontSize" 40
    EDIT [[TXTWINNER]] "Text" "P1 Wins!"

    DEFVAR "TXTHELP" 0 int
    RENDER 320 300 "TXTHELP" 10 "POPUP_SCORE"
    EDIT [[TXTHELP]] "FontSize" 12
    EDIT [[TXTHELP]] "Text" "[Space] Continue"
    EDIT [[TXTHELP]] "Tint.R" 150
    EDIT [[TXTHELP]] "Tint.G" 150
    EDIT [[TXTHELP]] "Tint.B" 150
    
    SHOW false "POPUP*"

@MENU_SHOW
    WAIT 0.5
    SHOW true "POPUP_MENU"
    
    TWEEN [[MENU_TITLE]] "Y" -25 0 true 0.4 "QUAD"
    TWEEN [[MENU_TITLE]] "Opacity" 0 1 false 0.3 "QUAD"

    TWEEN [[MENU_BUTTON1]] "X" -10 0 true 0.8 "QUAD"
    TWEEN [[MENU_BUTTON1]] "Opacity" 0 1 false 0.5 "QUAD"

    TWEEN [[MENU_BUTTON2]] "X" 10 0 true 0.8 "QUAD"
    TWEEN [[MENU_BUTTON2]] "Opacity" 0 1 false 0.5 "QUAD"
    WAIT 1

    >LOOP
        JUMPKEYPRESS "Escape" EXIT
        JUMPKEYPRESS "One" P1
        JUMPKEYPRESS "Two" P2
        
        WAITFRAME
        JUMP LOOP
    
    >EXIT
        SETVAR "SYS:REQ_EXIT" true
        BREAK

    >P1
        SETVAR "IS_2PLAYER" false
        CALL "BUTTON_PRESS [[MENU_BUTTON1]]"
        JUMP MENU_CLOSE

    >P2
        SETVAR "IS_2PLAYER" true
        CALL "BUTTON_PRESS [[MENU_BUTTON2]]"
        JUMP MENU_CLOSE

    >MENU_CLOSE
        WAIT 1
        SHOW false "POPUP_MENU"
        BREAK

@GAME_START
	EDIT [[TXTSCORE1]] "Text" [[SCORE1]]
	EDIT [[TXTSCORE2]] "Text" [[SCORE2]]

@ON_PAUSE
    SHOW true "POPUP_PAUSE"
    
    TWEEN [[PAUSE_TITLE]] "Y" -25 0 true 0.4 "QUAD"
    TWEEN [[PAUSE_TITLE]] "Opacity" 0 1 false 0.3 "QUAD"

    TWEEN [[PAUSE_RESUME]] "X" -10 0 true 0.8 "QUAD"
    TWEEN [[PAUSE_RESUME]] "Opacity" 0 1 false 0.5 "QUAD"

    TWEEN [[PAUSE_EXIT]] "X" 10 0 true 0.8 "QUAD"
    TWEEN [[PAUSE_EXIT]] "Opacity" 0 1 false 0.5 "QUAD"

    >PAUSELOOP
    	JUMPKEYPRESS "Escape" UNPAUSE
        JUMPKEYPRESS "Enter" PAUSEQUIT
    
        WAITFRAME
        JUMP PAUSELOOP

    >UNPAUSE
        CALL "BUTTON_PRESS [[PAUSE_RESUME]]"
        WAIT 0.5
        SHOW false "POPUP_PAUSE"
        BREAK

    >PAUSEQUIT
        CALL "BUTTON_PRESS [[PAUSE_EXIT]]"
        SHOW false "POPUP_PAUSE"
        SETVAR "REQ_MENU" true
        BREAK

@SERVE_RESET
    SHOW true "POPUP_SERVE"
    TWEEN [[TXTSERVE]] "Opacity" 0 1 false 0.3 "QUAD"
    BREAK

@SERVE_CANCEL
    SHOW false "POPUP_SERVE"
    BREAK

@SERVE_START
    TWEEN [[TXTSERVE]] "Opacity" 1 0 false 0.2 "QUAD"
    WAIT 0.2
    SHOW false "POPUP_SERVE"
    BREAK

@ON_SCORE
	EDIT [[TXTSCORE1]] "Text" [[SCORE1]]
	EDIT [[TXTSCORE2]] "Text" [[SCORE2]]

@ON_END <winner>
    SHOW true "POPUP_SCORE"
    TWEEN [[TXTWINNER]] "Y" -20 0 true 0.3 "QUAD"
    TWEEN [[TXTWINNER]] "Opacity" 0 1 false 0.2 "QUAD"
    
    TWEEN [[TXTHELP]] "Y" 20 0 true 0.8 "QUAD"
    TWEEN [[TXTHELP]] "Opacity" 0 1 false 0.8 "QUAD"

    EDIT [[TXTWINNER]] "Text" "P[[WINNER]] WINS!"
    WAIT 1
    CALL "WAITPRESS Space"
    JUMP END

>END
    SHOW false "POPUP_SCORE"
    BREAK