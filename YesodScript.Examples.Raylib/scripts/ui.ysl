@_INIT
    DEFVAR "UI_BG_DARK" 0 int
    DEFVAR "UI_BG_BAR" 0 int
    DEFVAR "TXTSCORE1" 0 int
    DEFVAR "TXTSCORE2" 0 int

@MENU_SHOW
    RENDER 160 30 "TXTSCORE1"
    EDIT [[TXTSCORE1]] "Text" 0
    EDIT [[TXTSCORE1]] "Tint.R" 0
    EDIT [[TXTSCORE1]] "Tint.G" 255
    EDIT [[TXTSCORE1]] "Tint.B" 255

    RENDER 480 30 "TXTSCORE2"
    EDIT [[TXTSCORE2]] "Text" 0
    EDIT [[TXTSCORE2]] "Tint.R" 255
    EDIT [[TXTSCORE2]] "Tint.G" 0
    EDIT [[TXTSCORE2]] "Tint.B" 0

    SHOW true "UI*"
    PRINT "PLAY"
    WAIT 1
    CALL "WAITPRESS Space"
    JUMP END


@ON_END <winner>
	EDIT [[TXTSCORE1]] "Text" [[SCORE1]]
	EDIT [[TXTSCORE2]] "Text" [[SCORE2]]
    SHOW true "UI*"
    PRINT "P[[WINNER]] WINS!"
    WAIT 1
    CALL "WAITPRESS Space"
    JUMP END

>END
    SHOW false "UI*"
    BREAK