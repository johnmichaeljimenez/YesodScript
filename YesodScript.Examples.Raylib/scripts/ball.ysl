@BALL_INIT
SETVAR VX [[BALL_SPEED]]
SETVAR VY [[BALL_SPEED]]
BREAK

@BALL_MOVE
	ADD BALL_X VX
	ADD BALL_Y VY

	JUMPLE BALL_Y 0 HIT_UP
	JUMPGE BALL_Y 340 HIT_UP

	JUMP AFTER

>HIT_UP
	MUL VY -1
	JUMP AFTER

>HIT_DOWN
	MUL VY -1
	JUMP AFTER

>AFTER
	EDIT [[BALL]] "X" [[BALL_X]]
	EDIT [[BALL]] "Y" [[BALL_Y]]
	JUMP END

>END
	BREAK