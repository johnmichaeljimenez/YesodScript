@GAME_INIT
DEFVAR "BALL_SPEED" 11 int
DEFVAR "BALL_SIZE" 22 int
DEFVAR "BALL_SIZE_HALF" 11 int

#player (p1)
DEFVAR "BALL_TO" -1 int

DEFVAR "BALL" 0 int
DEFVAR "BALL_X" 300 int
DEFVAR "BALL_Y" 200 int
DEFVAR "BALL_T" 0 int
DEFVAR "BALL_B" 0 int
DEFVAR "VX" 0 int
DEFVAR "VY" 0 int

DEFVAR "BALL_YSIGN" 1 int

DEFVAR "BALL_XOFF" 0 int

@RESET
	SETVAR BALL_X [[GAME_WIDTH]]
	SETVAR BALL_Y [[GAME_HEIGHT]]

	DIV BALL_X 2
	DIV BALL_Y 2
	
	SETVAR BALL_XOFF [[BALL_TO]]
	MUL BALL_XOFF 250
	ADD BALL_X BALL_XOFF
	
	EDIT [[BALL]] "X" [[BALL_X]]
	EDIT [[BALL]] "Y" [[BALL_Y]]

	SETVAR VX [[BALL_TO]]
	MUL VX [[BALL_SPEED]]

	RANDVAR VY 4 8
	RNG 0.5 AFTER
	MUL VY -1
	BREAK

@BALL_MOVE
	ADD BALL_X VX
	ADD BALL_Y VY

	SETVAR BALL_T [[BALL_Y]]
	SUB BALL_T [[BALL_SIZE_HALF]]
	SETVAR BALL_B [[BALL_Y]]
	ADD BALL_B [[BALL_SIZE_HALF]]

	JUMPLE BALL_T 0 BOUNCE_Y
	JUMPGE BALL_B [[GAME_HEIGHT]] BOUNCE_Y

	JUMP CHECK_SIDE

@CHECK_SIDE

	JUMPLT BALL_X 0 POINT_P2
	JUMPGT BALL_X GAME_WIDTH POINT_P1

	JUMPLE BALL_X P1_X AFTER
	JUMPGE BALL_X P2_X AFTER

	JUMPLE BALL_X P1_XPAD BOUNCE_PADDLE1
	JUMPGE BALL_X P2_XPAD BOUNCE_PADDLE2

	JUMP AFTER

>POINT_P2
	SETVAR "WINNER" 2
	SETVAR BALL_TO -1
	BREAK

>POINT_P1
	SETVAR "WINNER" 1
	SETVAR BALL_TO 1
	BREAK

>BOUNCE_Y
	MUL VY -1
	CALL "SIGN [[VY]] BALL_YSIGN"
	JUMP CHECK_SIDE

>BOUNCE_PADDLE1
	JUMPLE BALL_B P1_T AFTER
	JUMPGE BALL_T P1_B AFTER
	SETVAR VX "[[BALL_SPEED]]"
	
	RANDVAR VY 4 8
	MUL VY [[BALL_YSIGN]]

	CALL "PADDLE_HIT 1"
	JUMP AFTER

>BOUNCE_PADDLE2
	JUMPLE BALL_B P2_T AFTER
	JUMPGE BALL_T P2_B AFTER
	SETVAR VX "-[[BALL_SPEED]]"
	
	RANDVAR VY 4 8
	MUL VY [[BALL_YSIGN]]

	CALL "PADDLE_HIT 2"
	JUMP AFTER

>AFTER
	EDIT [[BALL]] "X" [[BALL_X]]
	EDIT [[BALL]] "Y" [[BALL_Y]]
	JUMP END

>END
	BREAK