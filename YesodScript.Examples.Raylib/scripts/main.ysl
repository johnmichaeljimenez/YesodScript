@_INIT

PRINT "INITIALIZING..."
LOADSPRITES "assets"

DEFVAR "BALL" 0 int

CLEAR
RENDER 4 4 "BALL"
EDIT [[BALL]] "SpriteID" "ballBlue"

>LOOP
	JUMPIF "SYS:REQ_EXIT" END
	JUMPCLICK TESTCLICK

	JUMP AFTER

>TESTCLICK
	PRINT "CLICKED AT [[SYS:MOUSE_X]] [[SYS:MOUSE_Y]]"
	JUMP AFTER
	
>AFTER
	WAITFRAME
	JUMP LOOP

>END
	PRINT "GAME END"