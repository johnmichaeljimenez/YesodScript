@_INIT

PRINT "INITIALIZING..."
LOADSPRITES "assets"
LOADSOUNDS "assets"

DEFVAR "GAME_WIDTH" 640 int
DEFVAR "GAME_HEIGHT" 360 int
DEFVAR "IS_2PLAYER" false bool
CLEAR

CALL "GAME_INIT"

DEFVAR "PADDLE_SPEED" 10 int
DEFVAR "PADDLE_LENGTH" 100 int
DEFVAR "PADDLE_LENGTH_HALF" [[PADDLE_LENGTH]] int
DIV PADDLE_LENGTH_HALF 2

DEFVAR "P1" 0 int
DEFVAR "P1_X" 40 int
DEFVAR "P1_Y" [[GAME_HEIGHT]] int
DEFVAR "P1_T" 0 int
DEFVAR "P1_B" 0 int

DEFVAR "P2" 0 int
DEFVAR "P2_X" [[GAME_WIDTH]] int
SUB P2_X 40
DEFVAR "P2_Y" [[GAME_HEIGHT]] int
DEFVAR "P2_T" 0 int
DEFVAR "P2_B" 0 int

DEFVAR "P1_XPAD" [[P1_X]] int
ADD P1_XPAD 10
DEFVAR "P2_XPAD" [[P2_X]] int
ADD P2_XPAD -10

DEFVAR SCORE1 0 int
DEFVAR SCORE2 0 int
DEFVAR "WINNER" 0 int

DEFVAR "BG" 0 int


RENDER 320 180 "BG"
EDIT [[BG]] "SpriteID" "bg"

RENDER [[BALL_X]] [[BALL_Y]] "BALL"
EDIT [[BALL]] "SpriteID" "ball"

RENDER [[P1_X]] [[P1_Y]] "P1"
EDIT [[P1]] "SpriteID" "paddleBlu"

RENDER [[P2_X]] [[P2_Y]] "P2"
EDIT [[P2]] "SpriteID" "paddleRed"

SETVAR "P1_Y" [[GAME_HEIGHT]]
SETVAR "P2_Y" [[GAME_HEIGHT]]
DIV P1_Y 2
DIV P2_Y 2
EDIT [[P1]] "Y" [[P1_Y]]
EDIT [[P2]] "Y" [[P2_Y]]

CALL "MENU_SHOW"

JUMP RESET

>RESET
	EDIT [[BALL]] "Disabled" false
	SETVAR "P1_Y" [[GAME_HEIGHT]]
	SETVAR "P2_Y" [[GAME_HEIGHT]]
	DIV P1_Y 2
	DIV P2_Y 2

	SETVAR "WINNER" 0
	EDIT [[P1]] "Y" [[P1_Y]]
	EDIT [[P2]] "Y" [[P2_Y]]
	CALL "RESET"

	PRINT "READY?"
	WAIT 1
	CALL "WAITPRESS Space"
	WAIT 0.5
	PRINT "START!"

	JUMP LOOP

>LOOP
	JUMPIF "SYS:REQ_EXIT" END
	JUMPKEY W UP1
	JUMPKEY S DOWN1

	JUMP P2

	>UP1
		SUB P1_Y PADDLE_SPEED
		CALL "CLAMP P1_Y [[P1_Y]] 0 [[GAME_HEIGHT]]"
		EDIT [[P1]] "Y" [[P1_Y]]
		JUMP P2
	>DOWN1
		ADD P1_Y PADDLE_SPEED
		CALL "CLAMP P1_Y [[P1_Y]] 0 [[GAME_HEIGHT]]"
		EDIT [[P1]] "Y" [[P1_Y]]
		JUMP P2

>P2
	JUMPEQ "IS_2PLAYER" false P2_AI

	JUMPKEY UP UP2
	JUMPKEY DOWN DOWN2

	JUMP AFTER

	>UP2
		SUB P2_Y PADDLE_SPEED
		CALL "CLAMP P2_Y [[P2_Y]] 0 [[GAME_HEIGHT]]"
		EDIT [[P2]] "Y" [[P2_Y]]
		JUMP AFTER
	>DOWN2
		ADD P2_Y PADDLE_SPEED
		CALL "CLAMP P2_Y [[P2_Y]] 0 [[GAME_HEIGHT]]"
		EDIT [[P2]] "Y" [[P2_Y]]
		JUMP AFTER

>P2_AI
	CALL AI_PADDLE
	JUMP AFTER
	
>AFTER
	SETVAR P1_T [[P1_Y]]
	SETVAR P1_B [[P1_Y]]
	SUB P1_T PADDLE_LENGTH_HALF
	ADD P1_B PADDLE_LENGTH_HALF

	SETVAR P2_T [[P2_Y]]
	SETVAR P2_B [[P2_Y]]
	SUB P2_T PADDLE_LENGTH_HALF
	ADD P2_B PADDLE_LENGTH_HALF

	CALL "BALL_MOVE"
	JUMPEQ "WINNER" 1 WIN
	JUMPEQ "WINNER" 2 LOSE

	WAITFRAME
	JUMP LOOP

>WIN
	ADD SCORE1 1
	CALL "ON_SCORE"
	EDIT [[BALL]] "Disabled" true
	CALL "ON_END [[WINNER]]"
	JUMP RESET

>LOSE
	ADD SCORE2 1
	CALL "ON_SCORE"
	EDIT [[BALL]] "Disabled" true
	CALL "ON_END [[WINNER]]"
	JUMP RESET

>END
	PRINT "GAME END"