@_INIT

PRINT "INITIALIZING..."
DEFVAR "TEST_ID" 0 int

CLEAR
RENDER 4 4 "TEST_ID"
EDIT [[TEST_ID]] "Text" "HELLO"

>LOOP
	JUMPIF "SYS:REQ_EXIT" END
	JUMPCLICK TESTCLICK

	EDIT [[TEST_ID]] "Text" "[[SYS:MOUSE_X]] [[SYS:MOUSE_Y]]"
	JUMP AFTER

>TESTCLICK
	PRINT "CLICKED AT [[SYS:MOUSE_X]] [[SYS:MOUSE_Y]]"
	JUMP AFTER
	
>AFTER
	WAITFRAME
	JUMP LOOP

>END
	PRINT "GAME END"