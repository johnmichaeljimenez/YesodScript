@_INIT

PRINT "INITIALIZING..."
LOADSPRITES "assets"

DEFVAR "GAME_WIDTH" 640 int
DEFVAR "GAME_HEIGHT" 360 int

DEFVAR "PADDLE_SPEED" 8 int
DEFVAR "PADDLE_LENGTH" 104 int
DEFVAR "PADDLE_LENGTH_HALF" [[PADDLE_LENGTH]] int
DIV PADDLE_LENGTH_HALF 2

DEFVAR "P1" 0 int
DEFVAR "P1_X" 20 int
DEFVAR "P1_Y" 150 int
DEFVAR "P1_T" 0 int
DEFVAR "P1_B" 0 int

DEFVAR "P2" 0 int
DEFVAR "P2_X" 600 int
DEFVAR "P2_Y" 150 int
DEFVAR "P2_T" 0 int
DEFVAR "P2_B" 0 int

DEFVAR "P1_XPAD" [[P1_X]] int
ADD P1_XPAD 20
DEFVAR "P2_XPAD" [[P2_X]] int
ADD P2_XPAD -20

CLEAR

RENDER [[BALL_X]] [[BALL_Y]] "BALL"
EDIT [[BALL]] "SpriteID" "ballBlue"

RENDER [[P1_X]] [[P1_Y]] "P1"
EDIT [[P1]] "SpriteID" "paddleBlu"

RENDER [[P2_X]] [[P2_Y]] "P2"
EDIT [[P2]] "SpriteID" "paddleRed"

CALL "BALL_RESET"

>LOOP
	JUMPIF "SYS:REQ_EXIT" END
	JUMPCLICK CLICK
	JUMPKEY W UP
	JUMPKEY S DOWN

	JUMP AFTER

	>CLICK
		PRINT "CLICKED AT [[SYS:MOUSE_X]] [[SYS:MOUSE_Y]]"
		JUMP AFTER

	>UP
		SUB P1_Y PADDLE_SPEED
		CALL "CLAMP P1_Y [[P1_Y]] 0 [[GAME_HEIGHT]]"
		EDIT [[P1]] "Y" [[P1_Y]]
		JUMP AFTER
	>DOWN
		ADD P1_Y PADDLE_SPEED
		CALL "CLAMP P1_Y [[P1_Y]] 0 [[GAME_HEIGHT]]"
		EDIT [[P1]] "Y" [[P1_Y]]
		JUMP AFTER
	
>AFTER
	CALL AI_PADDLE
	
	SETVAR P1_T [[P1_Y]]
	SETVAR P1_B [[P1_Y]]
	SUB P1_T PADDLE_LENGTH_HALF
	ADD P1_B PADDLE_LENGTH_HALF

	SETVAR P2_T [[P2_Y]]
	SETVAR P2_B [[P2_Y]]
	SUB P2_T PADDLE_LENGTH_HALF
	ADD P2_B PADDLE_LENGTH_HALF

	CALL "BALL_MOVE"

	WAITFRAME
	JUMP LOOP

>END
	PRINT "GAME END"