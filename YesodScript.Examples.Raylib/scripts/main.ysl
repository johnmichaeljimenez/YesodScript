@_INIT

PRINT "INITIALIZING..."
LOADSPRITES "assets"

DEFVAR "BALL_SPEED" 64 int
DEFVAR "PADDLE_SPEED" 90 int

DEFVAR "BALL" 0 int
DEFVAR "BALL_X" 300 int
DEFVAR "BALL_Y" 200 int
DEFVAR "VX" 0 int
DEFVAR "VY" 0 int

DEFVAR "P1" 0 int
DEFVAR "P1_X" 20 int
DEFVAR "P1_Y" 150 int

DEFVAR "P2" 0 int
DEFVAR "P2_X" 600 int
DEFVAR "P2_Y" 150 int

CLEAR

RENDER [[BALL_X]] [[BALL_Y]] "BALL"
EDIT [[BALL]] "SpriteID" "ballBlue"

RENDER [[P1_X]] [[P1_Y]] "P1"
EDIT [[P1]] "SpriteID" "paddleBlu"

RENDER [[P2_X]] [[P2_Y]] "P2"
EDIT [[P2]] "SpriteID" "paddleRed"

>LOOP
	JUMPIF "SYS:REQ_EXIT" END
	JUMPCLICK CLICK
	JUMPKEY W UP
	JUMPKEY S DOWN

	JUMP AFTER

>CLICK
	PRINT "CLICKED AT [[SYS:MOUSE_X]] [[SYS:MOUSE_Y]]"
	JUMP AFTER

>UP
	PRINT "UP"
	JUMP AFTER
>DOWN
	PRINT "DOWN"
	JUMP AFTER
	
>AFTER
	WAITFRAME
	JUMP LOOP

>END
	PRINT "GAME END"