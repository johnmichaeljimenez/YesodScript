@_INIT
LOADASSETS "assets"
$INFO_INIT

PRINT "GAME INITIALIZED"

DEFVAR MENU_RESULT -1 int

DEFLIST MENUS string
LISTADD MENUS "Continue"
LISTADD MENUS "New Game"
LISTADD MENUS "Exit"

>MENU_START
	$MENU MENUS "MENU_RESULT"

	JUMPEQ MENU_RESULT 0 CONTINUE
	JUMPEQ MENU_RESULT 1 NEW_GAME
	JUMPEQ MENU_RESULT 2 EXIT_GAME
	JUMP END

>CONTINUE
	SETVAR NEWGAME false
	JUMP PLAY

>NEW_GAME
	SETVAR NEWGAME true
	JUMP PLAY

>PLAY
	$FADE_IN
	$GAME_INIT
	$GAME_TICK

	JUMP MENU_START

>EXIT_GAME
	JUMP END

>END
	SETVAR "SYS:REQ_EXIT" true
	BREAK