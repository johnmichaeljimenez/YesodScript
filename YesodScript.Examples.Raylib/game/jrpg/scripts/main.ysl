@_INIT
LOADASSETS "assets"
$INFO_INIT

PRINT "GAME INITIALIZED"

DEFVAR MENU_RESULT -1 int

DEFLIST MENUS string
LISTADD MENUS "Play"
LISTADD MENUS "Exit"

>MENU_START
	$MENU MENUS "MENU_RESULT"

	JUMPEQ MENU_RESULT 0 PLAY
	JUMPEQ MENU_RESULT 1 EXIT_GAME
	JUMP END

>PLAY
	PRINT "Selected: Play"
	$FADE_IN
	$GAME_INIT
	$GAME_TICK

	JUMP MENU_START

>EXIT_GAME
	PRINT "Selected: Exit"
	JUMP END

>END
	SETVAR "SYS:REQ_EXIT" true
	BREAK