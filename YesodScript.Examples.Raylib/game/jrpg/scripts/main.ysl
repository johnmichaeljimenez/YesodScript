@_INIT
LOADASSETS "assets"

PRINT "GAME INITIALIZED"

DEFVAR MENU_RESULT -1 int

>MENU_START
	$MENU "Play" "Exit" * * * "MENU_RESULT"

	JUMPEQ MENU_RESULT 0 PLAY
	JUMPEQ MENU_RESULT 1 EXIT_GAME
	JUMP END

>PLAY
	PRINT "Selected: Play"
	$FADE_IN
	$GAME_INIT
	$GAME_TICK

	JUMP MENU_START

>EXIT_GAME
	PRINT "Selected: Exit"
	JUMP END

>END
	SETVAR "SYS:REQ_EXIT" true
	BREAK