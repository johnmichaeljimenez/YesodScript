# Save + apply on current map if that id is loaded.
# state 0/1 refresh entity sprite (SpriteDefault / SpriteDisabled)
# 2 clears render
@MAP_SET_TILE_STATE <id> <state>
    JUMPEQ <id> 0 MAP_SET_TILE_STATE_END

    $MAP_SAVE_STATE <id> <state>

    DEFVAR _idx -1 int
    LISTFIND TILE_IDS <id> _idx
    JUMPLT _idx 0 MAP_SET_TILE_STATE_END

    LISTSET TILE_STATES [[_idx]] <state>
    $TILE_REFRESH_ENTITY_RENDER [[_idx]]

    >MAP_SET_TILE_STATE_END
        BREAK

@MAP_SET_TILE_STATE_FADE <id> <state>
    JUMPEQ <id> 0 MAP_SET_TILE_STATE_FADE_END

    $MAP_SAVE_STATE <id> <state>

    DEFVAR _idx -1 int
    LISTFIND TILE_IDS <id> _idx
    JUMPLT _idx 0 MAP_SET_TILE_STATE_FADE_END

    LISTSET TILE_STATES [[_idx]] <state>

    # fade-out only when becoming Invisible; otherwise swap sprite immediately
    JUMPNEQ <state> 2 MAP_SET_TILE_STATE_FADE_REFRESH
    $TILE_CLEAR_RENDER_FADE [[_idx]]
    BREAK

    >MAP_SET_TILE_STATE_FADE_REFRESH
        $TILE_REFRESH_ENTITY_RENDER [[_idx]]
        BREAK

    >MAP_SET_TILE_STATE_FADE_END
        BREAK
