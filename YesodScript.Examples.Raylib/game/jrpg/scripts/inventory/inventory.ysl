@_INIT
    DEFLIST INVENTORY_INFOIDS string
    DEFLIST INVENTORY_INFONAME string

    DEFLIST INVENTORY_ITEMID string
    DEFLIST INVENTORY_ITEMQTY int

@INVENTORY_ADD_INFO <id> <name>
    LISTADD INVENTORY_INFOIDS <id>
    LISTADD INVENTORY_INFONAME <name>
    BREAK

@INVENTORY_ADD_ITEM <id> <qty>

    >ADD_END
        BREAK

@INVENTORY_GET_ID <index> <outvar>
    LISTGET INVENTORY_ITEMID <index> <outvar>

@INVENTORY_USE_ITEM <id>
    BREAK

@INVENTORY_CLEAR
    LISTCLEAR INVENTORY_ITEMID
    LISTCLEAR INVENTORY_ITEMQTY