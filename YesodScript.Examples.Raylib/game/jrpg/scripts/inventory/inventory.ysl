@_INIT
    DEFLIST INVENTORY_INFOIDS string
    DEFLIST INVENTORY_INFONAME string

    DEFLIST INVENTORY_ITEMID string
    DEFLIST INVENTORY_ITEMQTY int

@INVENTORY_ADD_INFO <id> <name>
    LISTADD INVENTORY_INFOIDS <id>
    LISTADD INVENTORY_INFONAME <name>
    BREAK

@INVENTORY_ADD_ITEM <id> <qty>
    DEFVAR _existing -1 int
    LISTFIND INVENTORY_ITEMID <id> _existing
    JUMPGE _existing true EXISTING

    DEFVAR _amt 0 int
    LISTGET INVENTORY_ITEMQTY <id> _amt
    ADD _amt <qty>
    LISTSET INVENTORY_ITEMQTY <id> _amt
    BREAK

    >EXISTING
        LISTADD INVENTORY_ITEMID <id>
        LISTADD INVENTORY_ITEMQTY <qty>
        BREAK

@INVENTORY_GET_ID <index> <outvar>
    LISTGET INVENTORY_ITEMID <index> <outvar>

@INVENTORY_USE_ITEM <id>
    BREAK

@INVENTORY_CLEAR
    $LISTCLEAR2 INVENTORY_ITEMID INVENTORY_ITEMQTY