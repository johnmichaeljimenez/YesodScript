@_INIT
    DEFVAR NEWGAME true bool

@SAVE:INIT
    $PARTY_CLEAR "ENEMY"

@SAVE:NEWGAME
    $INVENTORY_CLEAR
    $PARTY_CLEAR "PLAYER"

    $PARTY_ADD "PLAYER" "david"

@SAVE:SAVEPROGRESS
    SETVAR MAP_SAVE_CURRENT_ID [[MAP_NAME]]
    SETVAR MAP_SAVE_CURRENT_X [[PLAYER_POS_X]]
    SETVAR MAP_SAVE_CURRENT_Y [[PLAYER_POS_Y]]
    DIV MAP_SAVE_CURRENT_X [[GRID_SIZE]]
    DIV MAP_SAVE_CURRENT_Y [[GRID_SIZE]]
    SAVEDATA "player" "slot-0"