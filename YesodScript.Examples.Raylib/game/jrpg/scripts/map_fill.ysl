@MAP_FILL <w> <h>
    SETVAR MAP_W <w>
    SETVAR MAP_H <h>
    
    DEFVAR _LAST_X <w> int
    DEFVAR _LAST_Y <h> int
    SUB _LAST_X 1
    SUB _LAST_Y 1

    DEFVAR _size <w> int
    MUL _size <h>

    PRINT "MAP SIZE [[_size]]"
    $TILE_FILL [[_size]]
    PRINT "ADDED [[_size]] TILES"
    BREAK
