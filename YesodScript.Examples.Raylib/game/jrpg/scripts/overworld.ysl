@_INIT
    DEFVAR "GRID_SIZE" 16 int
    DEFVAR "GRID_SPEED" 0.1 float

    DEFVAR "PLAYER_POS_X" 0 int
    DEFVAR "PLAYER_POS_Y" 0 int
    DEFVAR "PLAYER_DIR_X" 0 int
    DEFVAR "PLAYER_DIR_Y" 0 int
    DEFVAR "PLAYER_BLOCKED" false bool
    DEFVAR "PLAYER_TRIGGER_ID" -1 int
    DEFVAR SPR_PLAYER 0 int

@OVERWORLD_INIT
    CLEAR "overworld*"

    SETVAR "PLAYER_POS_X" 0
    SETVAR "PLAYER_POS_Y" 0

    $MAP_INIT "test"

    RENDER [[PLAYER_POS_X]] [[PLAYER_POS_Y]] SPR_PLAYER "-[[PLAYER_POS_Y]]" "overworld_character"
    EDIT [[SPR_PLAYER]] "SpriteID" "r0_c3"
    EDIT [[SPR_PLAYER]] "World" true

    DEFVAR _midx [[MAP_W]] int
    DEFVAR _midy [[MAP_H]] int
    DIV _midx 2
    DIV _midy 2
    MUL _midx [[GRID_SIZE]]
    MUL _midy [[GRID_SIZE]]

    CAM [[_midx]] [[_midy]] 1.5

@OVERWORLD_END
    $MAP_CLEAR
    CLEAR "overworld*"

@OVERWORLD_MOVE <x> <y>
    SETVAR PLAYER_DIR_X <x>
    SETVAR PLAYER_DIR_Y <y>
    DEFVAR _prevX [[PLAYER_POS_X]] int
    DEFVAR _prevY [[PLAYER_POS_Y]] int

    DEFVAR _toX <x> int
    DEFVAR _toY <y> int

    MUL _toX [[GRID_SIZE]]
    MUL _toY [[GRID_SIZE]]

    ADD _toX [[PLAYER_POS_X]]
    ADD _toY [[PLAYER_POS_Y]]

    DEFVAR _tileX [[_toX]] int
    DEFVAR _tileY [[_toY]] int
    DIV _tileX [[GRID_SIZE]]
    DIV _tileY [[GRID_SIZE]]

    JUMPLT _tileX 0 MOVE_END
    JUMPLT _tileY 0 MOVE_END

    $MAP_STEP [[_tileX]] [[_tileY]] "PLAYER_BLOCKED" "PLAYER_TRIGGER_ID"
    JUMPEQ PLAYER_BLOCKED true MOVE_END

    SETVAR PLAYER_POS_X [[_toX]]
    SETVAR PLAYER_POS_Y [[_toY]]

    #non-tween mode
    # EDIT [[SPR_PLAYER]] "X" [[PLAYER_POS_X]]
    # EDIT [[SPR_PLAYER]] "Y" [[PLAYER_POS_Y]]

    #tween mode
    TWEEN [[SPR_PLAYER]] "X" [[_prevX]] [[PLAYER_POS_X]] false [[GRID_SPEED]] "QUAD" "MOVE_X"
    TWEEN [[SPR_PLAYER]] "Y" [[_prevY]] [[PLAYER_POS_Y]] false [[GRID_SPEED]] "QUAD" "MOVE_Y"

    TWEEN [[SPR_PLAYER]] "Depth" "-[[PLAYER_POS_Y]]"

    WAIT [[GRID_SPEED]]

    PRINT "MOVED TO [[PLAYER_POS_X]], [[PLAYER_POS_Y]]"

    #wait for movement before executing any trigger
    JUMPEQ "PLAYER_TRIGGER_ID" -1 MOVE_END

    $INTERACT [[PLAYER_TRIGGER_ID]]
    SETVAR "PLAYER_TRIGGER_ID" -1

    >MOVE_END
        BREAK