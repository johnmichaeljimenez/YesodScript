@_INIT
    DEFVAR REQ_EXIT_TO_MENU false bool

@GAME_INIT
    $SAVE:INIT
    
    JUMPEQ NEWGAME false GAME_INIT_LOAD
    $SAVE:NEWGAME
    JUMP GAME_INIT_READY

    >GAME_INIT_LOAD
        LOADDATA "player" "slot-0"

    >GAME_INIT_READY
        $OVERWORLD_INIT
        SAVEDATA "player" "slot-0"
        $FADE_OUT

@GAME_TICK
    DEFVAR _t 0 int

    >LOOP
        JUMPEQ REQ_EXIT_TO_MENU true END
        JUMPKEYPRESS "Escape" PAUSE
        JUMPKEY "C" TESTCOMBAT
        JUMPKEY "W" MOVE_UP
        JUMPKEY "S" MOVE_DOWN
        JUMPKEY "A" MOVE_LEFT
        JUMPKEY "D" MOVE_RIGHT

        JUMP AFTER
    
    >TESTCOMBAT
        $COMBAT_BEGIN
        JUMP AFTER

    >MOVE_UP
        JUMPGT _t 0 AFTER
        SETVAR _t 3
        $OVERWORLD_MOVE 0 -1
        JUMP AFTER
    >MOVE_DOWN
        JUMPGT _t 0 AFTER
        SETVAR _t 3
        $OVERWORLD_MOVE 0 1
        JUMP AFTER
    >MOVE_LEFT
        JUMPGT _t 0 AFTER
        SETVAR _t 3
        $OVERWORLD_MOVE -1 0
        JUMP AFTER
    >MOVE_RIGHT
        JUMPGT _t 0 AFTER
        SETVAR _t 3
        $OVERWORLD_MOVE 1 0
        JUMP AFTER

    >AFTER
        JUMPLE _t 0 AFTERWAIT
        SUB _t 1

    >AFTERWAIT
        WAITFRAME
        JUMP LOOP

    >PAUSE
        $PAUSE_MENU
        JUMP LOOP

    >END
        SETVAR REQ_EXIT_TO_MENU false
        $OVERWORLD_END
        BREAK