@_INIT
    

@GAME_INIT
    $PARTY_CLEAR "PLAYER"
    $PARTY_CLEAR "ENEMY"

    $PARTY_ADD "PLAYER" "david"

    LOADDATA "player" "slot-0"
    SAVEDATA "player" "slot-0"

    $OVERWORLD_INIT
	$FADE_OUT

@GAME_TICK
    DEFVAR _t 0 int

    >LOOP
        JUMPKEYPRESS "Escape" END
        JUMPKEY "C" TESTCOMBAT
        JUMPKEY "W" MOVE_UP
        JUMPKEY "S" MOVE_DOWN
        JUMPKEY "A" MOVE_LEFT
        JUMPKEY "D" MOVE_RIGHT

        JUMP AFTER
    
    >TESTCOMBAT
        $COMBAT_BEGIN
        JUMP AFTER

    >MOVE_UP
        JUMPGT _t 0 AFTER
        SETVAR _t 3
        $OVERWORLD_MOVE 0 -1
        JUMP AFTER
    >MOVE_DOWN
        JUMPGT _t 0 AFTER
        SETVAR _t 3
        $OVERWORLD_MOVE 0 1
        JUMP AFTER
    >MOVE_LEFT
        JUMPGT _t 0 AFTER
        SETVAR _t 3
        $OVERWORLD_MOVE -1 0
        JUMP AFTER
    >MOVE_RIGHT
        JUMPGT _t 0 AFTER
        SETVAR _t 3
        $OVERWORLD_MOVE 1 0
        JUMP AFTER

    >AFTER
        JUMPLE _t 0 AFTERWAIT
        SUB _t 1

    >AFTERWAIT
        WAITFRAME
        JUMP LOOP

    >END
        $OVERWORLD_END
        BREAK