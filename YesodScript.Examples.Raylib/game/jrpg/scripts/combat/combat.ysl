@_INIT
    DEFLIST C_CURRENTACTIONS int
    DEFLIST C_ACTEDMEMBERS int
    DEFLIST C_MENU_LABELS string
    DEFLIST C_MENU_IDS int
    DEFLIST C_ACTIONS string

    #0 = selection, 1 = battle
    DEFVAR C_PHASE 0 int
    DEFVAR C_RESULT -1 int
    DEFVAR C_PCOUNT 0 int
    DEFVAR C_ECOUNT 0 int
    DEFVAR C_ACTOR 0 int
    DEFVAR C_TARGET 0 int
    DEFVAR C_ACTION_ID * string
    DEFVAR C_TARGETTYPE 0 int

@COMBAT_BEGIN
    DEFVAR _i 0 int
    DEFVAR _n 0 int
    DEFVAR _cid 0 int
    DEFVAR _name "?" string
    DEFVAR _last -1 int
    DEFVAR _acted false bool
    DEFVAR _c 0 int
    DEFVAR _hp 0 int

    $LIST_CLEAR4 C_CURRENTACTIONS C_ACTEDMEMBERS C_MENU_LABELS C_MENU_IDS
    SETVAR C_PHASE 0
    SETVAR C_ACTOR 0
    SETVAR C_TARGET 0
    SETVAR C_ACTION_ID *
    SETVAR C_TARGETTYPE 0

    #testing only
    $PARTY_CLEAR "ENEMY"
    $PARTY_ADD "ENEMY" "wolf"

    $FADE_IN
    PRINT "COMBAT START!"
    $WAITPRESS "Space"
    >COMBAT_LOOP
        $ACTION_CLEAR
        $LIST_CLEAR2 C_ACTEDMEMBERS C_CURRENTACTIONS
        $PARTY_REFRESH
        $PARTY_COUNT_ALIVE "PLAYER" C_PCOUNT
        $PARTY_COUNT_ALIVE "ENEMY" C_ECOUNT
        JUMPEQ C_PCOUNT 0 COMBAT_END
        JUMPEQ C_ECOUNT 0 COMBAT_END

        >PHASE_START
            $LIST_COUNT_NOT_IN PPLAYER_ACTING C_ACTEDMEMBERS C_PCOUNT
            JUMPEQ C_PCOUNT 0 PHASE_RESOLVE

            PRINT "SELECTION PHASE"
            $WAITPRESS "Space"

            >SELECT_PLAYER
                $LIST_CLEAR2 C_MENU_LABELS C_MENU_IDS
                SETVAR _i 0
                LISTCOUNT PPLAYER_ACTING _n

                >BUILD_PLAYER_MENU_LOOP
                    JUMPGE _i [[_n]] BUILD_PLAYER_MENU_DONE
                    LISTGET PPLAYER_ACTING [[_i]] _cid
                    $LIST_CONTAINS C_ACTEDMEMBERS [[_cid]] _acted
                    JUMPEQ _acted true BUILD_PLAYER_MENU_NEXT

                    LISTADD C_MENU_IDS [[_cid]]
                    $CHARACTER_NAME [[_cid]] _name
                    LISTADD C_MENU_LABELS [[_name]]

                    >BUILD_PLAYER_MENU_NEXT
                        ADD _i 1
                        JUMP BUILD_PLAYER_MENU_LOOP

                >BUILD_PLAYER_MENU_DONE
                    $MENU C_MENU_LABELS C_RESULT
                    JUMPLT C_RESULT 0 PHASE_START
                    LISTGET C_MENU_IDS [[C_RESULT]] C_ACTOR

            >SELECT_ACTION
                $ACTION_CHARACTER_LABELS [[C_ACTOR]] C_ACTIONS
                $MENU C_ACTIONS C_RESULT
                JUMPLT C_RESULT 0 SELECT_PLAYER
                LISTGET ACTION_C_IDS [[C_RESULT]] C_ACTION_ID
                $ACTION_PREVALIDATE [[C_ACTOR]] [[C_ACTION_ID]]
                JUMPEQ ACTION_C_VALID false SELECT_ACTION

                $ACTIONINFO_GET_TARGETTYPE [[C_ACTION_ID]] C_TARGETTYPE
                # targettype 0 = enemy menu, anything else = self / no targeting menu
                JUMPNEQ C_TARGETTYPE 0 SELECT_SELF_TARGET

            >SELECT_TARGET
                $PARTY_LABELS "ALIVE" "ENEMY" C_MENU_LABELS
                $MENU C_MENU_LABELS C_RESULT
                JUMPLT C_RESULT 0 PHASE_START
                LISTGET PENEMY_ALIVE [[C_RESULT]] C_TARGET
                JUMP SELECT_END

            >SELECT_SELF_TARGET
                SETVAR C_TARGET [[C_ACTOR]]
                JUMP SELECT_END

            >SELECT_END
                LISTADD C_ACTEDMEMBERS [[C_ACTOR]]
                $ACTION_SUBMIT [[C_ACTION_ID]] [[C_ACTOR]] [[C_TARGET]]
                $LIST_LAST_INDEX ACTIONS_ID _last
                LISTADD C_CURRENTACTIONS [[_last]]
                JUMP PHASE_START

        >PHASE_RESOLVE
            $PARTY_REFRESH
            PRINT "RESOLVE PHASE"
            $WAITPRESS "Space"

            $COMBAT_AI_ACTIONS
            $COMBAT_SPD_SORT

        >BATTLE_PHASE
            PRINT "BATTLE PHASE"
            $WAITPRESS "Space"

            LISTCOUNT ACTIONS_ID _c

            SETVAR  _i 0
            >BP_LOOP
                JUMPGE _i [[_c]] END_PHASE
                LISTGET ACTIONS_INFOID [[_i]] C_ACTION_ID
                LISTGET ACTIONS_SOURCE [[_i]] C_ACTOR
                LISTGET ACTIONS_TARGET [[_i]] C_TARGET

                #hp check
                $CHARACTER_GET [[C_ACTOR]] "HP" _hp
                JUMPLE _hp 0 BP_NEXT
                $CHARACTER_GET [[C_TARGET]] "HP" _hp
                JUMPLE _hp 0 BP_NEXT

                $BUFFS:TICK [[C_ACTOR]]
                
                #hp check again (ex. died from burn tick)
                $CHARACTER_GET [[C_ACTOR]] "HP" _hp
                JUMPLE _hp 0 BP_NEXT

                #TODO: change to random alive target
                $CHARACTER_GET [[C_TARGET]] "HP" _hp
                JUMPLE _hp 0 BP_NEXT

                # skip if actor can no longer perform this action (mana/cooldown/etc)
                $ACTION_PREVALIDATE [[C_ACTOR]] [[C_ACTION_ID]]
                JUMPEQ ACTION_C_VALID false BP_NEXT

                $COMBAT:ACTION:ONSTART [[C_ACTION_ID]] [[C_ACTOR]] [[C_TARGET]]
                CALL "COMBAT:ACTION:[[C_ACTION_ID]] [[C_ACTOR]] [[C_TARGET]]"
                $WAITPRESS "Space"

                >BP_NEXT
                    ADD _i 1
                    JUMP BP_LOOP

        >END_PHASE
            $BUFFS:ENDTURN
            JUMP COMBAT_LOOP
            BREAK

    >COMBAT_END
        JUMPEQ C_PCOUNT 0 COMBAT_LOSE
        JUMPEQ C_ECOUNT 0 COMBAT_WIN
        JUMP COMBAT_END_DONE

    >COMBAT_WIN
        PRINT "YOU WIN!"
        #stub: rewards, exp, return to overworld, etc.
        JUMP COMBAT_END_DONE

    >COMBAT_LOSE
        PRINT "YOU LOSE!"
        #stub: game over / retreat flow, etc.
        JUMP COMBAT_END_DONE

    >COMBAT_END_DONE
        $BUFFS:CLEAR
        $STATUS_EFFECT_CLEAR
        PRINT "COMBAT END"
        $FADE_OUT
        BREAK
