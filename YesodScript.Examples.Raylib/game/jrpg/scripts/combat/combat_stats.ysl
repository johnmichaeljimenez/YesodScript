@_INIT

@COMBAT_APPLY_DAMAGE <from> <to> <dmg>
	# dragon quest formula: (atk/2)-(def/4), plink min 1
	DEFVAR _atk <dmg> int
	DEFVAR _def 0 int
	DEFVAR _hp 0 int
	DEFVAR _final 0 int
	DEFVAR _halfAtk 0 int
	DEFVAR _quarterDef 0 int

	$CHARACTER_INFO <to> "DEF" _def

	SETVAR _halfAtk [[_atk]]
	DIV _halfAtk 2
	SETVAR _quarterDef [[_def]]
	DIV _quarterDef 4

	SETVAR _final [[_halfAtk]]
	SUB _final [[_quarterDef]]

	#plink
	JUMPGE _final 1 COMBAT_APPLY_DAMAGE_APPLY
	SETVAR _final 1

	>COMBAT_APPLY_DAMAGE_APPLY
		$CHARACTER_GET_HP <to> _hp
		SUB _hp [[_final]]
		JUMPGE _hp 0 COMBAT_APPLY_DAMAGE_SET
		SETVAR _hp 0

	>COMBAT_APPLY_DAMAGE_SET
		$CHARACTER_STATS <to> "HP" [[_hp]]
		PRINT "<from> hits <to> for [[_final]] damage (HP=[[_hp]])"
		BREAK