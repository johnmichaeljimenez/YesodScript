@INFO_INIT
    $ACTIONINFO_CREATE "attack" "Attack" 0
    $ACTIONINFO_CREATE "defend" "Defend" 1
    $ACTIONINFO_CREATE "pass" "Pass" 1

@COMBAT:ACTION:ATTACK <from> <to>
    DEFVAR _dmg 0 int
    $CHARACTER_INFO <from> "ATK" _dmg
    $COMBAT_APPLY_DAMAGE <from> <to> [[_dmg]]
    
@COMBAT:ACTION:DEFEND <from>
    PRINT "<from> defends"
    
@COMBAT:ACTION:PASS <from>
    PRINT "<from> skipped turn"