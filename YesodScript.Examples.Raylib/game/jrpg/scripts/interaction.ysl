@INTERACT <id>
    # <id> is the 1D tile index (from MAP_STEP / PLAYER_TRIGGER_ID)
    DEFVAR _id 0 string
    DEFVAR _type 0 int
    DEFVAR _v1 0 string
    DEFVAR _v2 0 string
    DEFVAR _target 0 string
    DEFVAR _state false bool
    DEFVAR _index -1 int

    LISTGET TILE_IDS <id> _id
    LISTGET TILE_TYPES <id> _type
    LISTGET TILE_VALUES1 <id> _v1
    LISTGET TILE_VALUES2 <id> _v2
    LISTGET TILE_TARGETS <id> _target
    LISTGET TILE_STATES <id> _state

    # PRINT "INTERACT: <id> -> [[_type]] id=[[_id]] t=[[_target]]"

    # already disabled tiles should never reach here (MAP_STEP filters them)
    JUMPEQ _state true END

    JUMPEQ _type 6 I_TRIGGER
    JUMPEQ _type 3 I_NPC
    JUMPEQ _type 2 I_MISC
    JUMPEQ _type 5 I_SWITCH
    BREAK

    >I_TRIGGER
        JUMPEQ [[_v1]] "EXIT" I_TRIGGER_EXIT
        CALL "EV_TRIGGER [[MAP_NAME]] [[_id]]" I_TRIGGER_GENERIC
        BREAK

        >I_TRIGGER_GENERIC
            CALL "EV_TRIGGER_GENERIC"
            BREAK

        >I_TRIGGER_EXIT
            $FADE_IN

            JUMPEQ _target 0 I_TRIGGER_EXIT_BAD
            JUMPEQ _v2 0 I_TRIGGER_EXIT_BAD

            PRINT "EXIT -> [[_v2]] ([[_target]])"
            $MAP_INIT [[_v2]]

            DEFVAR _warpIdx -1 int
            LISTFIND TILE_IDS [[_target]] _warpIdx
            JUMPLT _warpIdx 0 I_TRIGGER_EXIT_MISSING

            $LIST_XY [[_warpIdx]] [[MAP_W]] MAP_WARP_X MAP_WARP_Y

            SETVAR PLAYER_POS_X [[MAP_WARP_X]]
            SETVAR PLAYER_POS_Y [[MAP_WARP_Y]]
            ADD PLAYER_POS_X [[PLAYER_DIR_X]]
            ADD PLAYER_POS_Y [[PLAYER_DIR_Y]]
            
            MUL PLAYER_POS_X [[GRID_SIZE]]
            MUL PLAYER_POS_Y [[GRID_SIZE]]

            DEFVAR _midx [[MAP_W]] int
            DEFVAR _midy [[MAP_H]] int
            DIV _midx 2
            DIV _midy 2
            MUL _midx [[GRID_SIZE]]
            MUL _midy [[GRID_SIZE]]
            CAM [[_midx]] [[_midy]] 1.5

            EDIT [[SPR_PLAYER]] "X" [[PLAYER_POS_X]]
            EDIT [[SPR_PLAYER]] "Y" [[PLAYER_POS_Y]]
            EDIT [[SPR_PLAYER]] "Depth" "-[[PLAYER_POS_Y]]"

            $FADE_OUT

            # PRINT "WARPED to [[_v2]] @ [[MAP_WARP_X]],[[MAP_WARP_Y]] -> [[PLAYER_POS_X]],[[PLAYER_POS_Y]] (id=[[_target]])"
            BREAK

            >I_TRIGGER_EXIT_MISSING
                PRINT "EXIT target '[[_target]]' not found in map '[[_v2]]'"
                BREAK

            >I_TRIGGER_EXIT_BAD
                PRINT "EXIT missing target/level (t=[[_target]] v2=[[_v2]])"
                BREAK

    >I_ITEM
        #add item here
        CALL "EV_ITEM [[MAP_NAME]] [[_v1]] [[_v2]]" I_ITEM_GENERIC
        BREAK

        >I_ITEM_GENERIC
            CALL "EV_ITEM_GENERIC [[_v1]] [[_v2]]"
            BREAK

    >I_NPC
        CALL "EV_NPC [[MAP_NAME]] [[_v1]]" I_NPC_GENERIC
        BREAK

        >I_NPC_GENERIC
            $TALK [[_v1]] "..."
            CALL "EV_NPC_GENERIC [[_v1]]"
            BREAK

    >I_MISC
        CALL "EV_MISC [[MAP_NAME]] [[_id]]" I_MISC_GENERIC
        BREAK

        >I_MISC_GENERIC
            CALL "EV_MISC_GENERIC"
            BREAK

    >I_SWITCH
        #one-shot
        $MAP_DISABLE_TILE <id>

        JUMPEQ _target 0 I_SWITCH_GENERIC

        DEFVAR _i 0 int
        DEFVAR _n 0 int
        DEFVAR _cur 0 string
        LISTCOUNT TILE_IDS _n

        >I_SWITCH_LOOP
            JUMPGE _i [[_n]] I_SWITCH_DONE
            LISTGET TILE_IDS [[_i]] _cur
            JUMPNEQ _cur [[_target]] I_SWITCH_NEXT
            $MAP_DISABLE_TILE [[_i]]

            >I_SWITCH_NEXT
                ADD _i 1
                JUMP I_SWITCH_LOOP

        >I_SWITCH_DONE
            CALL "EV_SWITCH [[MAP_NAME]] [[_target]]" I_SWITCH_GENERIC
            BREAK

        >I_SWITCH_GENERIC
            CALL "EV_SWITCH_GENERIC"
            BREAK

    >END
        BREAK