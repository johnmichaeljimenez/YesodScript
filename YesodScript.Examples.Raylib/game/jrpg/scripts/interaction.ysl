@INTERACT <id>
    # <id> is the 1D tile index (from MAP_STEP / PLAYER_TRIGGER_ID)
    DEFVAR _id 0 string
    DEFVAR _type 0 int
    DEFVAR _v1 0 string
    DEFVAR _v2 0 string
    DEFVAR _target 0 string
    DEFVAR _state 0 int
    DEFVAR _index -1 int
    DEFVAR _alias * string

    $TILE_GET_ROW <id> _id _type _v1 _v2 _target _state _alias

    # PRINT "INTERACT: <id> -> [[_type]] id=[[_id]] alias=[[_alias]] t=[[_target]]"

    # only Active (0) is interactable (MAP_STEP should already filter this)
    JUMPNEQ _state 0 END

    JUMPEQ _type 7 I_SAVEPOINT
    JUMPEQ _type 6 I_TRIGGER
    JUMPEQ _type 4 I_ITEM
    JUMPEQ _type 3 I_NPC
    JUMPEQ _type 2 I_MISC
    JUMPEQ _type 5 I_SWITCH
    BREAK

    >I_SAVEPOINT
        $FADE_IN
        $SAVE:SAVEPROGRESS
        WAIT 1
        $FADE_OUT
        BREAK

    >I_TRIGGER
        JUMPNEQ _target 0 I_TRIGGER_EXIT
        CALL "EV_TRIGGER:[[MAP_NAME]]:[[_alias]] [[_id]]" I_TRIGGER_GENERIC
        BREAK

        >I_TRIGGER_GENERIC
            CALL "EV_TRIGGER_GENERIC"
            BREAK

        >I_TRIGGER_EXIT
            $FADE_IN

            JUMPEQ _v2 0 I_TRIGGER_EXIT_BAD

            PRINT "EXIT -> [[_v2]] ([[_target]])"
            $MAP_INIT [[_v2]]

            DEFVAR _warpIdx -1 int
            LISTFIND TILE_IDS [[_target]] _warpIdx
            JUMPLT _warpIdx 0 I_TRIGGER_EXIT_MISSING

            $LIST_XY [[_warpIdx]] [[MAP_W]] MAP_WARP_X MAP_WARP_Y

            SETVAR PLAYER_POS_X [[MAP_WARP_X]]
            SETVAR PLAYER_POS_Y [[MAP_WARP_Y]]
            ADD PLAYER_POS_X [[PLAYER_DIR_X]]
            ADD PLAYER_POS_Y [[PLAYER_DIR_Y]]
            
            MUL PLAYER_POS_X [[GRID_SIZE]]
            MUL PLAYER_POS_Y [[GRID_SIZE]]

            $CAMERA_RESET

            EDIT [[SPR_PLAYER]] "X" [[PLAYER_POS_X]]
            EDIT [[SPR_PLAYER]] "Y" [[PLAYER_POS_Y]]
            EDIT [[SPR_PLAYER]] "Depth" "-[[PLAYER_POS_Y]]"

            $FADE_OUT

            # PRINT "WARPED to [[_v2]] @ [[MAP_WARP_X]],[[MAP_WARP_Y]] -> [[PLAYER_POS_X]],[[PLAYER_POS_Y]] (id=[[_target]])"
            BREAK

            >I_TRIGGER_EXIT_MISSING
                PRINT "EXIT target '[[_target]]' not found in map '[[_v2]]'"
                BREAK

            >I_TRIGGER_EXIT_BAD
                PRINT "EXIT missing target/level (t=[[_target]] v2=[[_v2]])"
                BREAK

    >I_ITEM
        $MAP_SET_TILE_STATE [[_id]] 1

        $INVENTORY_ADD_ITEM [[_v1]] [[_v2]]
        CALL "EV_ITEM:[[MAP_NAME]]:[[_alias]] [[_v1]] [[_v2]]" I_ITEM_GENERIC
        BREAK

        >I_ITEM_GENERIC
            CALL "EV_ITEM_GENERIC [[_v1]] [[_v2]]"
            BREAK

    >I_NPC
        CALL "EV_NPC:[[MAP_NAME]]:[[_v1]]" I_NPC_GENERIC
        BREAK

        >I_NPC_GENERIC
            CALL "EV_NPC_GENERIC [[_v1]]"
            BREAK

    >I_MISC
        CALL "EV_MISC:[[MAP_NAME]]:[[_alias]]" I_MISC_GENERIC
        BREAK

        >I_MISC_GENERIC
            CALL "EV_MISC_GENERIC"
            BREAK

    >I_SWITCH
        # one-shot switch: stay visible/blocking, but no longer interactable
        $MAP_SET_TILE_STATE [[_id]] 1

        JUMPEQ _target 0 I_SWITCH_EVENT

        # target id is global — works on this map now, and on other maps via save restore
        # (level_6 switch -> test gate e94b4120, and vice versa)
        $MAP_SET_TILE_STATE_FADE [[_target]] 2

        >I_SWITCH_EVENT
            CALL "EV_SWITCH:[[MAP_NAME]]:[[_alias]] [[_target]]" I_SWITCH_GENERIC
            BREAK

        >I_SWITCH_GENERIC
            CALL "EV_SWITCH_GENERIC"
            BREAK

    >END
        BREAK
