# Tile types
# 0 - blank
# 1 - blocker
# 2 - misc
# 3 - npc
# 4 - item
# 5 - switch
# 6 - trigger
# 7 - savepoint

@_INIT
    DEFVAR MAP_TEMP_CURRENT -1 int
    DEFVAR MAP_WARP_X 0 int
    DEFVAR MAP_WARP_Y 0 int

    # key-value pair for tracking object states across map loads
    # key = tile object id (unique across maps), value = TILE_STATES
    # 0 Active, 1 Non_Interactable, 2 Invisible
    # Shared ids (e.g. same gate targeted from multiple maps) share one saved state.
    DEFLIST MAP_SAVE_ID string
    DEFLIST MAP_SAVE_VALUE int

    REGSAVEVAR "player" MAP_SAVE_ID
    REGSAVEVAR "player" MAP_SAVE_VALUE


    #lists are 1d here, but I have function that returns x,y parameter into int 1d index

    #resized depending on map
    DEFVAR MAP_W 0 int
    DEFVAR MAP_H 0 int

    DEFVAR MAP_HAS_SPAWN true bool
    DEFVAR MAP_SPAWN_X 32 int
    DEFVAR MAP_SPAWN_Y 32 int
    DEFVAR MAP_NAME * string

    #id reference for targets
    DEFLIST TILE_IDS string
    #see above
    DEFLIST TILE_TYPES int
    #optional value 1 (ex. item "gold" 100)
    DEFLIST TILE_VALUES1 string
    #optional value 2 (ex. item gold "100")
    DEFLIST TILE_VALUES2 string
    #optional target id
    DEFLIST TILE_TARGETS string
    #tile state (ActiveType): 0 Active, 1 Non_Interactable, 2 Invisible
    DEFLIST TILE_STATES int
    #tile sprite id (floor tile)
    DEFLIST TILE_SPRITES string
    #tile sprite id (entity tile - if any)
    DEFLIST TILE_ENTITYSPRITES string
    #render data id for this tile (0 = none)
    DEFLIST TILE_RENDER int
    #optional alias for tiles (instead of referencing ids, useful for making custom events)
    DEFLIST TILE_ALIASES string

@MAP_CLEAR
    $TILE_CLEAR_ALL
    CLEAR "overworld_map*"
    PRINT "CLEARED MAP"

@MAP_INIT <mapname>
    SETVAR MAP_W 0
    SETVAR MAP_H 0
    SETVAR MAP_NAME <mapname>
    SETVAR MAP_HAS_SPAWN false

    $TILE_CLEAR_ALL

    PRINT "LOADING MAP"
    CLEAR "overworld_map*"
    CALL "MAPDATA:<mapname>" INIT_MAP_MISSING

    # restore switch/gate/etc. progress for this map
    $MAP_APPLY_SAVED_STATES

    JUMPEQ MAP_HAS_SPAWN false INIT_END
    SETVAR PLAYER_POS_X [[MAP_SPAWN_X]]
    SETVAR PLAYER_POS_Y [[MAP_SPAWN_Y]]
    MUL PLAYER_POS_X [[GRID_SIZE]]
    MUL PLAYER_POS_Y [[GRID_SIZE]]

    SETVAR MAP_HAS_SPAWN false
    JUMP INIT_END

    >INIT_MAP_MISSING
        PRINT "Missing map '<mapname>'"
        BREAK

    >INIT_END
        PRINT "Loaded map '<mapname>' [[MAP_W]]x[[MAP_H]]"
        BREAK

@MAP_STEP <x> <y> <blocked> <trigger>
    SETVAR <blocked> false

    JUMPEQ MAP_W 0 INTERACT_END
    JUMPEQ MAP_H 0 INTERACT_END

    JUMPLT <x> 0 INTERACT_END
    JUMPLT <y> 0 INTERACT_END
    JUMPGE <x> [[MAP_W]] INTERACT_END
    JUMPGE <y> [[MAP_H]] INTERACT_END

    $LIST_1D <x> <y> [[MAP_W]] [[MAP_H]] "MAP_TEMP_CURRENT"

    DEFVAR _tile 0 int
    DEFVAR _state 0 int
    LISTGET TILE_TYPES [[MAP_TEMP_CURRENT]] _tile
    LISTGET TILE_STATES [[MAP_TEMP_CURRENT]] _state

    # 2 Invisible = hidden + no collision/interaction (opened gates, etc.)
    JUMPEQ _state 2 INTERACT_END

    JUMPEQ _tile 0 INTERACT_END
    JUMPEQ _tile 4 INTERACT_ITEM
    JUMPEQ _tile 6 INTERACT_TRIGGER
    SETVAR <blocked> true
    JUMPEQ _tile 1 INTERACT_END

    # 1 Non_Interactable = still blocks, but no interaction
    JUMPEQ _state 1 INTERACT_END

    $INTERACT [[MAP_TEMP_CURRENT]]
    BREAK

    >INTERACT_ITEM
        # walkable pickup: only Active items fire after move completes
        JUMPNEQ _state 0 INTERACT_END
        SETVAR <trigger> [[MAP_TEMP_CURRENT]]
        JUMP INTERACT_END

    >INTERACT_TRIGGER
        # only Active triggers fire
        JUMPNEQ _state 0 INTERACT_END
        SETVAR <trigger> [[MAP_TEMP_CURRENT]]
        JUMP INTERACT_END

    >INTERACT_END
        SETVAR MAP_TEMP_CURRENT -1
        BREAK