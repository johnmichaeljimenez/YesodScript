# clear runtime progress (new game from main menu)
# real disk save/load can replace this later
@MAP_CLEAR_SAVED_STATES
    $LIST_CLEAR2 MAP_SAVE_ID MAP_SAVE_VALUE
    BREAK

# Persist tile state by object id (works across maps).
# Prefer $MAP_SET_TILE_STATE when you also want live apply on the current map.
@MAP_SAVE_STATE <id> <state>
    JUMPEQ <id> 0 MAP_SAVE_STATE_END
    $KV_SET MAP_SAVE_ID MAP_SAVE_VALUE <id> <state>

    >MAP_SAVE_STATE_END
        BREAK

@MAP_APPLY_SAVED_STATES
    DEFVAR _i 0 int
    DEFVAR _n 0 int
    DEFVAR _tid 0 string
    DEFVAR _idx -1 int
    DEFVAR _state 0 int

    LISTCOUNT TILE_IDS _n

    >MAP_APPLY_LOOP
        JUMPGE _i [[_n]] MAP_APPLY_DONE

        LISTGET TILE_IDS [[_i]] _tid
        JUMPEQ _tid 0 MAP_APPLY_NEXT

        LISTFIND MAP_SAVE_ID [[_tid]] _idx
        JUMPLT _idx 0 MAP_APPLY_NEXT

        LISTGET MAP_SAVE_VALUE [[_idx]] _state
        JUMPEQ _state 0 MAP_APPLY_NEXT

        LISTSET TILE_STATES [[_i]] [[_state]]

        # Invisible: drop render if present (opened gates, picked items, etc.)
        JUMPNEQ _state 2 MAP_APPLY_NEXT
        $TILE_CLEAR_RENDER [[_i]]

        >MAP_APPLY_NEXT
            ADD _i 1
            JUMP MAP_APPLY_LOOP

    >MAP_APPLY_DONE
        BREAK
