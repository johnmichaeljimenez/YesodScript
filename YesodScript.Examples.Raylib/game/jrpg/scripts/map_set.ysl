@MAP_SET <x> <y> <id> <type> <v1> <v2> <t> <state> <sprite> <entitysprite>
    $LIST_1D <x> <y> [[MAP_W]] [[MAP_H]] MAP_TEMP_CURRENT
    DEFVAR _tile [[MAP_TEMP_CURRENT]] int

    LISTSET TILE_IDS [[_tile]] <id>
    LISTSET TILE_TYPES [[_tile]] <type>
    LISTSET TILE_VALUES1 [[_tile]] <v1>
    LISTSET TILE_VALUES2 [[_tile]] <v2>
    LISTSET TILE_TARGETS [[_tile]] <t>
    LISTSET TILE_STATES [[_tile]] <state>
    LISTSET TILE_SPRITES [[_tile]] <sprite>
    LISTSET TILE_ENTITYSPRITES [[_tile]] <entitysprite>
    LISTSET TILE_RENDER [[_tile]] 0

    # PRINT "SET TILE AT <x> <y> ([[_tile]])"

    DEFVAR _x <x> int
    DEFVAR _y <y> int

    MUL _x [[GRID_SIZE]]
    MUL _y [[GRID_SIZE]]

    JUMPEQ <type> 0 END
    JUMPEQ <type> 6 END
    #2 Invisible = no render
    JUMPEQ <state> 2 END

    DEFVAR _rid 0 int
    RENDER [[_x]] [[_y]] _rid -100 "overworld_map_tile"
    EDIT [[_rid]] "SpriteID" "r0_c1"
    EDIT [[_rid]] "World" true
    LISTSET TILE_RENDER [[_tile]] [[_rid]]
    # PRINT "ADDED TILE RENDER [[_x]] [[_y]] rid=[[_rid]]"

>END
    BREAK

@MAP_DISABLE_TILE <tile>
    # set Invisible (2): hidden + non-interactable + walkthrough
    LISTSET TILE_STATES <tile> 2

    DEFVAR _rid 0 int
    LISTGET TILE_RENDER <tile> _rid
    JUMPLE _rid 0 MAP_DISABLE_DONE

    REMOVERENDER [[_rid]]
    LISTSET TILE_RENDER <tile> 0

    >MAP_DISABLE_DONE
        BREAK
