@_INIT
    #all members
    DEFLIST PLAYER_PARTY int
    DEFLIST ENEMY_PARTY int

    #alive only
    DEFLIST PPLAYER_ALIVE int
    DEFLIST PENEMY_ALIVE int

    #not stunned and alive (at least alive for now)
    DEFLIST PPLAYER_ACTING int
    DEFLIST PENEMY_ACTING int
    BREAK

@PARTY_CLEAR <from>
    $LIST_CLEAR3 "<from>_PARTY" "P<from>_ALIVE" "P<from>_ACTING"
    BREAK

@PARTY_ADD <from> <characterinfo>
    SETVAR CH_TEMP_ID 0
    $CHARACTER_CREATE <characterinfo> CH_TEMP_ID
    JUMPLE CH_TEMP_ID 0 PARTY_ADD_END

    LISTADD "<from>_PARTY" [[CH_TEMP_ID]]
    JUMP ON_REFRESH

    >PARTY_ADD_END
        BREAK

@PARTY_COUNT_ALIVE <from> <outvar>
    LISTCOUNT "P<from>_ALIVE" <outvar>
    BREAK

@PARTY_COUNT_ACTING <from> <outvar>
    LISTCOUNT "P<from>_ACTING" <outvar>
    BREAK

@PARTY_COUNT_ALL <from> <outvar>
    LISTCOUNT "<from>_PARTY" <outvar>
    BREAK

@PARTY_LABELS <type> <from> <outlist>
    DEFVAR _i 0 int
    DEFVAR _n 0 int
    DEFVAR _cid 0 int
    DEFVAR _name "?" string

    LISTCLEAR <outlist>
    LISTCOUNT "P<from>_<type>" _n

    >PARTY_LABELS_LOOP
        JUMPGE _i [[_n]] PARTY_LABELS_DONE

        LISTGET "P<from>_<type>" [[_i]] _cid
        $CHARACTER_NAME [[_cid]] _name
        LISTADD <outlist> [[_name]]
        ADD _i 1
        JUMP PARTY_LABELS_LOOP

    >PARTY_LABELS_DONE
        BREAK

#will be used outside during combat or any character-altering events
@PARTY_REFRESH
    JUMP ON_REFRESH

    #label is used for real calculation to avoid doing CALL on self (same instruction is already running)
    >ON_REFRESH
        $PARTY_REFRESH_SIDE "PLAYER"
        $PARTY_REFRESH_SIDE "ENEMY"
        BREAK
