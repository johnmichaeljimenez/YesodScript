@_INIT
    #infos (base templates)
    DEFLIST CHI_IDS string
    DEFLIST CHI_NAMES string
    DEFLIST CHI_MAX_HP int
    DEFLIST CHI_MAX_MP int
    DEFLIST CHI_ATK int
    DEFLIST CHI_SPD int
    DEFLIST CHI_DEF int

    #character info id
    DEFLIST CHI_ABILITY_CID string
    #ability string id
    DEFLIST CHI_ABILITY_AID string

    #instances
    #reference from character info above (character uses base data from character info)
    DEFLIST CH_REFS string
    #unique autogen id
    DEFLIST CH_IDS int
    DEFLIST CH_HP int
    DEFLIST CH_MP int

    DEFVAR CH_TEMP_ID 0 int
    DEFVAR CH_NEXT_ID 1 int
    BREAK

@CHARACTERINFO_CREATE <id> <name> <hp> <mp> <atk> <spd> <def>
    DEFVAR _idx -1 int
    LISTFIND CHI_IDS <id> _idx
    JUMPGE _idx 0 CHARACTERINFO_CREATE_END

    LISTADD CHI_IDS <id>
    LISTADD CHI_NAMES <name>
    LISTADD CHI_MAX_HP <hp>
    LISTADD CHI_MAX_MP <mp>
    LISTADD CHI_ATK <atk>
    LISTADD CHI_SPD <spd>
    LISTADD CHI_DEF <def>

    PRINT "CREATED CHARACTER INFO [<id>] <name> HP=<hp> MP=<mp> ATK=<atk> SPD=<spd> DEF=<def>"

    >CHARACTERINFO_CREATE_END
        BREAK

@CHARACTERINFO_ADD_ABILITY <cid> <aid>
    LISTADD CHI_ABILITY_CID <cid>
    LISTADD CHI_ABILITY_AID <aid>

@CHARACTER_CREATE <infoname> <outvar>
    DEFVAR _infoIdx -1 int
    DEFVAR _id 0 int
    DEFVAR _hp 0 int
    DEFVAR _mp 0 int

    LISTFIND CHI_IDS <infoname> _infoIdx
    JUMPLT _infoIdx 0 CHARACTER_CREATE_END

    LISTGET CHI_MAX_HP [[_infoIdx]] _hp
    LISTGET CHI_MAX_MP [[_infoIdx]] _mp

    SETVAR _id [[CH_NEXT_ID]]
    ADD CH_NEXT_ID 1

    LISTADD CH_REFS <infoname>
    LISTADD CH_IDS [[_id]]
    LISTADD CH_HP [[_hp]]
    LISTADD CH_MP [[_mp]]

    SETVAR <outvar> [[_id]]

    >CHARACTER_CREATE_END
        BREAK

@CHARACTER_INFO <id> <stat> <outvar>
    # SET <outvar> to id (instance)'s info as CHI_<stat>
    # ex. $CHARACTER_INFO 2 DEF _def
    DEFVAR _idx -1 int
    DEFVAR _infoIdx -1 int
    DEFVAR _ref * string

    SETVAR <outvar> 0
    LISTFIND CH_IDS <id> _idx
    JUMPLT _idx 0 CHARACTER_INFO_END

    LISTGET CH_REFS [[_idx]] _ref
    LISTFIND CHI_IDS [[_ref]] _infoIdx
    JUMPLT _infoIdx 0 CHARACTER_INFO_END

    LISTGET "CHI_<stat>" [[_infoIdx]] <outvar>

    >CHARACTER_INFO_END
        BREAK

@CHARACTER_STATS <id> <stat> <amt>
    DEFVAR _index -1 int
    LISTFIND CH_IDS <id> _index
    JUMPLT _index 0 CHARACTER_STATS_END

    LISTSET "CH_<stat>" [[_index]] <amt>

    >CHARACTER_STATS_END
        BREAK

@CHARACTER_REMOVE <id>
    DEFVAR _index -1 int
    LISTFIND CH_IDS <id> _index
    JUMPLT _index 0 CHARACTER_REMOVE_END

    $LIST_REMOVE_AT4 [[_index]] CH_REFS CH_IDS CH_HP CH_MP

    >CHARACTER_REMOVE_END
        BREAK

# Lookup helpers for other files (SoA readability).
@CHARACTER_FIND <id> <outIdx>
    LISTFIND CH_IDS <id> <outIdx>
    BREAK

@CHARACTER_GET_HP <id> <outHp>
    DEFVAR _idx -1 int
    LISTFIND CH_IDS <id> _idx
    JUMPLT _idx 0 CHARACTER_GET_HP_MISS
    LISTGET CH_HP [[_idx]] <outHp>
    BREAK

    >CHARACTER_GET_HP_MISS
        SETVAR <outHp> 0
        BREAK

@CHARACTER_GET_REF <id> <outRef>
    DEFVAR _idx -1 int
    LISTFIND CH_IDS <id> _idx
    JUMPLT _idx 0 CHARACTER_GET_REF_MISS
    LISTGET CH_REFS [[_idx]] <outRef>
    BREAK

    >CHARACTER_GET_REF_MISS
        SETVAR <outRef> *
        BREAK

@CHARACTER_NAME <id> <outName>
    DEFVAR _idx -1 int
    DEFVAR _infoIdx -1 int
    DEFVAR _ref * string

    SETVAR <outName> "?"
    LISTFIND CH_IDS <id> _idx
    JUMPLT _idx 0 CHARACTER_NAME_END

    LISTGET CH_REFS [[_idx]] _ref
    LISTFIND CHI_IDS [[_ref]] _infoIdx
    JUMPLT _infoIdx 0 CHARACTER_NAME_END
    LISTGET CHI_NAMES [[_infoIdx]] <outName>

    >CHARACTER_NAME_END
        BREAK
