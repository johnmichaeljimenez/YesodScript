@_INIT
    DEFVAR "CAM_ZOOM" 3 float
    DEFVAR "CAM_SPEED" 0.12 float
    DEFVAR "CAM_MARGIN" 4 int
    DEFVAR "CAM_FROM_X" 0 int
    DEFVAR "CAM_FROM_Y" 0 int
    DEFVAR "CAM_TO_X" 0 int
    DEFVAR "CAM_TO_Y" 0 int


@CAMERA_RESET
    # clamp initial camera into follow bounds
    DEFVAR _initMinX [[CAM_MARGIN]] int
    DEFVAR _initMinY [[CAM_MARGIN]] int
    DEFVAR _initMaxX [[MAP_W]] int
    DEFVAR _initMaxY [[MAP_H]] int
    SUB _initMaxX 1
    SUB _initMaxY 1
    SUB _initMaxX [[CAM_MARGIN]]
    SUB _initMaxY [[CAM_MARGIN]]
    MUL _initMinX [[GRID_SIZE]]
    MUL _initMinY [[GRID_SIZE]]
    MUL _initMaxX [[GRID_SIZE]]
    MUL _initMaxY [[GRID_SIZE]]

    SETVAR CAM_TO_X [[PLAYER_POS_X]]
    SETVAR CAM_TO_Y [[PLAYER_POS_Y]]
    $CLAMP CAM_TO_X [[CAM_TO_X]] [[_initMinX]] [[_initMaxX]]
    $CLAMP CAM_TO_Y [[CAM_TO_Y]] [[_initMinY]] [[_initMaxY]]
    CAM [[CAM_TO_X]] [[CAM_TO_Y]] [[CAM_ZOOM]]

@CAMERA_FOLLOW <prevX> <prevY>
    # camera follow with map-edge dead zone (CAM_MARGIN tiles)
    DEFVAR _movecam false bool
    DEFVAR _cam_minx [[CAM_MARGIN]] int
    DEFVAR _cam_miny [[CAM_MARGIN]] int
    DEFVAR _cam_maxx [[MAP_W]] int
    DEFVAR _cam_maxy [[MAP_H]] int

    SUB _cam_maxx 1
    SUB _cam_maxy 1
    SUB _cam_maxx [[CAM_MARGIN]]
    SUB _cam_maxy [[CAM_MARGIN]]
    MUL _cam_minx [[GRID_SIZE]]
    MUL _cam_miny [[GRID_SIZE]]
    MUL _cam_maxx [[GRID_SIZE]]
    MUL _cam_maxy [[GRID_SIZE]]

    SETVAR CAM_FROM_X <prevX>
    SETVAR CAM_FROM_Y <prevY>
    SETVAR CAM_TO_X [[PLAYER_POS_X]]
    SETVAR CAM_TO_Y [[PLAYER_POS_Y]]

    $CLAMP CAM_FROM_X [[CAM_FROM_X]] [[_cam_minx]] [[_cam_maxx]]
    $CLAMP CAM_FROM_Y [[CAM_FROM_Y]] [[_cam_miny]] [[_cam_maxy]]
    $CLAMP CAM_TO_X [[CAM_TO_X]] [[_cam_minx]] [[_cam_maxx]]
    $CLAMP CAM_TO_Y [[CAM_TO_Y]] [[_cam_miny]] [[_cam_maxy]]

    JUMPEQ CAM_FROM_X [[CAM_TO_X]] CAM_APPLY_Y
    SETVAR _movecam true
    TWEENCAM "X" [[CAM_FROM_X]] [[CAM_TO_X]] false [[CAM_SPEED]] "LINEAR" "CAM_X"

    >CAM_APPLY_Y
        JUMPEQ CAM_FROM_Y [[CAM_TO_Y]] CAM_WAIT_CHECK
        SETVAR _movecam true
        TWEENCAM "Y" [[CAM_FROM_Y]] [[CAM_TO_Y]] false [[CAM_SPEED]] "LINEAR" "CAM_Y"

    >CAM_WAIT_CHECK
        JUMPEQ _movecam true CAM_DO_WAIT
        WAIT [[GRID_SPEED]]
        BREAK

    >CAM_DO_WAIT
        WAIT [[CAM_SPEED]]