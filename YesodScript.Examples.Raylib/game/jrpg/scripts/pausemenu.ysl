@_INIT
    DEFLIST PAUSE_MENUS string

@PAUSE_MENU
    LISTCLEAR PAUSE_MENUS
    LISTADD PAUSE_MENUS "Resume Game"
    LISTADD PAUSE_MENUS "Back to main menu"
	$MENU PAUSE_MENUS "MENU_RESULT"
    
	JUMPEQ MENU_RESULT 0 RESUME
	JUMPEQ MENU_RESULT 1 QUIT
    BREAK

    >RESUME
    	BREAK

    >QUIT
        SETVAR REQ_EXIT_TO_MENU true
        BREAK