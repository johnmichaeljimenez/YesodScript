@ENEMY_HIT <id>
    JUMPEQ <id> -1 MISS

    DEFVAR _HP 0 int
    LISTGET EHP <id> _HP
    SUB _HP 1

    LISTSET EHP <id> [[_HP]]
    JUMPEQ _HP 0 KILL

    PRINT "HIT <id>"
    

    TWEEN <id> "Opacity" 1 0 false 0.4 "SHAKE" "OP-<id>"

>KILL
    PRINT "KILL <id>"
    CALL "DESPAWN <id>"
    JUMP END

>MISS
    JUMP END

>END
    BREAK