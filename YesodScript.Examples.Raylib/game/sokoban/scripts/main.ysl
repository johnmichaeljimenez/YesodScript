@_INIT
LOADASSETS "assets"

DEFVAR MENU_OUT 0 int
DEFLIST MENU string

>MENU_START
    $LOAD
    LISTCLEAR MENU
    JUMPLE LATEST_UNLOCKED_LEVEL 1 MENU_NEW_GAME
    LISTADD MENU "Continue"
    LISTADD MENU "Level Select"
    LISTADD MENU "Credits"
    LISTADD MENU "Exit"
    $MENU:FONT_SIZE 30
    $MENU MENU "MENU_OUT"
    JUMPEQ MENU_OUT 0 CONTINUE
    JUMPEQ MENU_OUT 1 OPEN_LEVEL_SELECT
    JUMPEQ MENU_OUT 2 CREDITS
    JUMP END

>MENU_NEW_GAME
    LISTADD MENU "Start"
    LISTADD MENU "Credits"
    LISTADD MENU "Exit"
    $MENU:FONT_SIZE 30
    $MENU MENU "MENU_OUT"
    JUMPEQ MENU_OUT 0 PLAY
    JUMPEQ MENU_OUT 1 CREDITS
    JUMP END

>CONTINUE
    JUMP PLAY

>OPEN_LEVEL_SELECT
    SETVAR LEVEL_SELECT_START_GAME false
    CALL "LEVEL_SELECT"
    JUMPEQ LEVEL_SELECT_START_GAME true PLAY
    JUMP MENU_START
    
>PLAY
    $FADE_IN
    $GAME:START
	JUMP MENU_START

>CREDITS
    $CREDITS:SHOW
    JUMP MENU_START
    BREAK

>END
    WAIT 0.2
    BREAK
