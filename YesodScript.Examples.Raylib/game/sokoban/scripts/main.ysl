@_INIT
LOADASSETS "assets"

DEFVAR MENU_OUT 0 int
DEFLIST MENU string
LISTADD MENU "Continue"
LISTADD MENU "Level Select"
LISTADD MENU "Exit"

>MENU_START
    $MENU MENU "MENU_OUT"
    JUMPEQ MENU_OUT 0 CONTINUE
    JUMPEQ MENU_OUT 1 LEVEL_SELECT
    JUMPEQ MENU_OUT 2 END
    JUMP END

>CONTINUE
    JUMP PLAY

>LEVEL_SELECT
    JUMP PLAY
    
>PLAY
    $LOAD
    $GAME:START
	JUMP MENU_START

>END
    BREAK
