@_INIT
LOADASSETS "assets"

$LEVEL_INIT "level_2"
$PLAYER_INIT

>LOOP
    JUMPKEYPRESS "Escape" END
    JUMPKEYPRESS "W" FACE_N
    JUMPKEYPRESS "S" FACE_S
    JUMPKEYPRESS "A" FACE_W
    JUMPKEYPRESS "D" FACE_E

    JUMP AFTER

>FACE_N
    $PLAYER_MOVE -180 0 -1
    JUMP AFTER

>FACE_E
    $PLAYER_MOVE 90 1 0
    JUMP AFTER

>FACE_S
    $PLAYER_MOVE 0 0 1
    JUMP AFTER

>FACE_W
    $PLAYER_MOVE -90 -1 0
    JUMP AFTER

>AFTER
    WAITFRAME
    JUMP LOOP

>END
    BREAK
