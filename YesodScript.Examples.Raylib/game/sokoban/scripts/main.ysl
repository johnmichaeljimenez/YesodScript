@_INIT
LOADASSETS "assets"

DEFVAR MENU_OUT 0 int
DEFLIST MENU string
LISTADD MENU "Continue"
LISTADD MENU "Level Select"
LISTADD MENU "Exit"

>MENU_START
    $LOAD
    $MENU MENU "MENU_OUT"
    JUMPEQ MENU_OUT 0 CONTINUE
    JUMPEQ MENU_OUT 1 OPEN_LEVEL_SELECT
    JUMPEQ MENU_OUT 2 END
    JUMP END

>CONTINUE
    JUMP PLAY

>OPEN_LEVEL_SELECT
    SETVAR LEVEL_SELECT_START_GAME false
    CALL "LEVEL_SELECT"
    JUMPEQ LEVEL_SELECT_START_GAME true PLAY
    JUMP MENU_START
    
>PLAY
    $GAME:START
	JUMP MENU_START

>END
    BREAK
