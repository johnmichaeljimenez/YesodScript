@GAME:START
    $HUD_INIT
    BGCOLOR 140 173 199
    SETVAR LEVEL_INDEX [[LATEST_CONTINUE_LEVEL]]
    $LEVEL_LOAD_CURRENT

    >LOOP
        JUMPKEYPRESS "Escape" END
        JUMPKEYPRESS "R" RESTART
        JUMPKEY "Z" UNDO
        JUMPKEY "U" UNDO
        JUMPKEYPRESS "X" SWITCH_HERO
        JUMPKEYPRESS "One" SELECT_WARRIOR
        JUMPKEYPRESS "Two" SELECT_THIEF
        JUMPKEYPRESS "Three" SELECT_WIZARD
        JUMPKEY "W" FACE_N
        JUMPKEY "S" FACE_S
        JUMPKEY "A" FACE_W
        JUMPKEY "D" FACE_E

        JUMP AFTER

    >RESTART
        $UNDO_PUSH
        $LEVEL_INIT [[LEVEL_NAME]]
        CALL "ON_RESTART"
        JUMP AFTER

    >UNDO
        $UNDO_POP
        CALL "ON_MOVES_UPDATE [[LEVEL_CURRENT_MOVES]]"
        WAIT 0.15
        JUMP AFTER

    >SWITCH_HERO
        $PLAYER_SWITCH
        JUMP AFTER

    >SELECT_WARRIOR
        $PLAYER_SELECT_TYPE 0
        JUMP AFTER

    >SELECT_THIEF
        $PLAYER_SELECT_TYPE 1
        JUMP AFTER

    >SELECT_WIZARD
        $PLAYER_SELECT_TYPE 2
        JUMP AFTER

    >FACE_N
        $PLAYER_MOVE -180 0 -1
        JUMP MOVEAFTER

    >FACE_E
        $PLAYER_MOVE 90 1 0
        JUMP MOVEAFTER

    >FACE_S
        $PLAYER_MOVE 0 0 1
        JUMP MOVEAFTER

    >FACE_W
        $PLAYER_MOVE -90 -1 0
        JUMP MOVEAFTER

    >MOVEAFTER
        WAIT 0.05
        JUMP AFTER

    >AFTER
        WAITFRAME
        JUMP LOOP

    >END
        BGCOLOR 0 0 0
        CLEAR
        BREAK
