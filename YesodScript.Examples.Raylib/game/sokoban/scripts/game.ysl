@GAME:START
    SETVAR LEVEL_INDEX [[LATEST_CONTINUE_LEVEL]]
    $LEVEL_LOAD_CURRENT

    >LOOP
        JUMPKEYPRESS "Escape" END
        JUMPKEYPRESS "R" RESTART
        JUMPKEYPRESS "Z" UNDO
        JUMPKEYPRESS "U" UNDO
        JUMPKEYPRESS "X" SWITCH_HERO
        JUMPKEYPRESS "One" SELECT_WARRIOR
        JUMPKEYPRESS "Two" SELECT_THIEF
        JUMPKEYPRESS "Three" SELECT_WIZARD
        JUMPKEYPRESS "W" FACE_N
        JUMPKEYPRESS "S" FACE_S
        JUMPKEYPRESS "A" FACE_W
        JUMPKEYPRESS "D" FACE_E

        JUMP AFTER

    >RESTART
        $UNDO_PUSH
        $LEVEL_INIT [[LEVEL_NAME]]
        CALL "ON_RESTART"
        JUMP AFTER

    >UNDO
        $UNDO_POP
        JUMP AFTER

    >SWITCH_HERO
        $PLAYER_SWITCH
        JUMP AFTER

    >SELECT_WARRIOR
        $PLAYER_SELECT_TYPE 0
        JUMP AFTER

    >SELECT_THIEF
        $PLAYER_SELECT_TYPE 1
        JUMP AFTER

    >SELECT_WIZARD
        $PLAYER_SELECT_TYPE 2
        JUMP AFTER

    >FACE_N
        $PLAYER_MOVE -180 0 -1
        JUMP AFTER

    >FACE_E
        $PLAYER_MOVE 90 1 0
        JUMP AFTER

    >FACE_S
        $PLAYER_MOVE 0 0 1
        JUMP AFTER

    >FACE_W
        $PLAYER_MOVE -90 -1 0
        JUMP AFTER

    >AFTER
        WAITFRAME
        JUMP LOOP

    >END
        CLEAR
        BREAK
