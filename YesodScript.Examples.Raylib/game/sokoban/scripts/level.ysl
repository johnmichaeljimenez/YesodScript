@_INIT
    DEFVAR LEVEL_TEMP -1 int
    DEFVAR LEVEL_W 0 int
    DEFVAR LEVEL_H 0 int
    DEFVAR LEVEL_NAME * string
    DEFVAR LEVEL_COUNT 0 int
    DEFVAR LEVEL_INDEX 1 int
    DEFLIST LEVEL_NAMES string

    DEFVAR LEVEL_HAS_SPAWN false bool
    DEFVAR LEVEL_SPAWN_X 0 int
    DEFVAR LEVEL_SPAWN_Y 0 int
    DEFVAR LEVEL_SPAWN_HERO 0 int

    DEFLIST LEVEL_SPAWN_XS int
    DEFLIST LEVEL_SPAWN_YS int
    DEFLIST LEVEL_SPAWN_HEROES int

    DEFLIST TILE_TYPES int
    # 0 floor, 1 wall, 2 box, 3 exit
    # 4 yellow switch (load), 5 yellow gate (closed)
    # 6 purple switch (load), 7 purple gate (closed)
    DEFLIST TILE_FLOOR int
    DEFLIST TILE_OBJ int

    # linear cell indices for exits, switches and gates (per color)
    DEFLIST EXIT_CELLS int
    DEFLIST SWITCH_YELLOW_CELLS int
    DEFLIST SWITCH_PURPLE_CELLS int
    DEFLIST GATE_YELLOW_CELLS int
    DEFLIST GATE_YELLOW_RIDS int
    DEFLIST GATE_PURPLE_CELLS int
    DEFLIST GATE_PURPLE_RIDS int
    DEFVAR GATES_YELLOW_OPEN false bool
    DEFVAR GATES_PURPLE_OPEN false bool
    DEFVAR GATES_LETHAL false bool

@LEVEL_INIT <levelname>
    $LEVEL_CLEAR
    SETVAR LEVEL_NAME <levelname>

    PRINT "LOADING LEVEL '<levelname>'"
    CALL "LEVELDATA:<levelname>" LEVEL_INIT_MISSING
    $LEVEL_BUILD_VISUALS

    #aim camera at level center
    DEFVAR _cx [[LEVEL_W]] int
    DEFVAR _cy [[LEVEL_H]] int
    DIV _cx 2
    DIV _cy 2

    DEFVAR _fromY [[_cy]] int
    ADD _fromY 4
    DEFVAR _fromZ 14 int

    CAM3D [[_cx]] [[_fromY]] [[_fromZ]]  [[_cx]] [[_cy]] 0  45 false

    $HEROES_INIT
    JUMP LEVEL_INIT_END

    >LEVEL_INIT_MISSING
        PRINT "Missing level '<levelname>'"
        BREAK

    >LEVEL_INIT_END
        PRINT "Loaded level '<levelname>' [[LEVEL_W]]x[[LEVEL_H]] heroes=[[HERO_COUNT]] active=[[px]],[[py]]"
        BREAK
