@LEVEL_STEP <x> <y> <blocked> <tile>
    SETVAR <blocked> false
    SETVAR <tile> 0

    JUMPEQ LEVEL_W 0 LEVEL_STEP_END
    JUMPEQ LEVEL_H 0 LEVEL_STEP_END

    JUMPLT <x> 0 LEVEL_STEP_OOB
    JUMPLT <y> 0 LEVEL_STEP_OOB
    JUMPGE <x> [[LEVEL_W]] LEVEL_STEP_OOB
    JUMPGE <y> [[LEVEL_H]] LEVEL_STEP_OOB

    $LIST_1D <x> <y> [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
    LISTGET TILE_TYPES [[LEVEL_TEMP]] <tile>

    # 1 wall blocks
    JUMPEQ <tile> 1 LEVEL_STEP_BLOCK
    # 2 box: blocked here, player may push via LEVEL_PUSH
    JUMPEQ <tile> 2 LEVEL_STEP_BLOCK
    # 5 yellow closed gate / 7 purple closed gate block
    JUMPEQ <tile> 5 LEVEL_STEP_BLOCK
    JUMPEQ <tile> 7 LEVEL_STEP_BLOCK
    # 0 floor / 3 exit are walkable
    JUMP LEVEL_STEP_END

    >LEVEL_STEP_OOB
        SETVAR <blocked> true
        JUMP LEVEL_STEP_END

    >LEVEL_STEP_BLOCK
        SETVAR <blocked> true
        JUMP LEVEL_STEP_END

    >LEVEL_STEP_END
        SETVAR LEVEL_TEMP -1
        BREAK

@LEVEL_GET <x> <y> <tile>
    SETVAR <tile> 0
    JUMPEQ LEVEL_W 0 LEVEL_GET_END
    JUMPEQ LEVEL_H 0 LEVEL_GET_END
    JUMPLT <x> 0 LEVEL_GET_END
    JUMPLT <y> 0 LEVEL_GET_END
    JUMPGE <x> [[LEVEL_W]] LEVEL_GET_END
    JUMPGE <y> [[LEVEL_H]] LEVEL_GET_END

    $LIST_1D <x> <y> [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
    LISTGET TILE_TYPES [[LEVEL_TEMP]] <tile>

    >LEVEL_GET_END
        BREAK

@LEVEL_PUSH <bx> <by> <dx> <dy> <ok>
    SETVAR <ok> false

    DEFVAR _scanX <bx> int
    DEFVAR _scanY <by> int
    DEFVAR _scanType 0 int
    DEFVAR _boxCount 0 int

    >LEVEL_PUSH_SCAN
        JUMPLT _scanX 0 LEVEL_PUSH_END
        JUMPLT _scanY 0 LEVEL_PUSH_END
        JUMPGE _scanX [[LEVEL_W]] LEVEL_PUSH_END
        JUMPGE _scanY [[LEVEL_H]] LEVEL_PUSH_END

        $LIST_1D [[_scanX]] [[_scanY]] [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
        LISTGET TILE_TYPES [[LEVEL_TEMP]] _scanType
        JUMPNEQ _scanType 2 LEVEL_PUSH_SCAN_DONE
        ADD _boxCount 1
        ADD _scanX <dx>
        ADD _scanY <dy>
        JUMP LEVEL_PUSH_SCAN

    >LEVEL_PUSH_SCAN_DONE
        # The whole line moves only if its far end is empty floor/exit (not gate).
        JUMPNEQ _boxCount 0 LEVEL_PUSH_CHECK_END
        JUMP LEVEL_PUSH_END

    >LEVEL_PUSH_CHECK_END
        # Only empty floor or an exit can hold the far end of the chain.
        JUMPEQ _scanType 0 LEVEL_PUSH_SHIFT_START
        JUMPEQ _scanType 3 LEVEL_PUSH_SHIFT_START
        JUMP LEVEL_PUSH_END

    >LEVEL_PUSH_SHIFT_START
        DEFVAR _boxX [[_scanX]] int
        DEFVAR _boxY [[_scanY]] int
        SUB _boxX <dx>
        SUB _boxY <dy>
        DEFVAR _destX 0 int
        DEFVAR _destY 0 int
        DEFVAR _from 0 int
        DEFVAR _rid 0 int

        >LEVEL_PUSH_SHIFT
            JUMPGT _boxCount 0 LEVEL_PUSH_SHIFT_BOX
            JUMP LEVEL_PUSH_OK

        >LEVEL_PUSH_SHIFT_BOX
            $LIST_1D [[_boxX]] [[_boxY]] [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
            LISTGET TILE_TYPES [[LEVEL_TEMP]] _from
            JUMPNEQ _from 2 LEVEL_PUSH_END
            LISTGET TILE_OBJ [[LEVEL_TEMP]] _rid
            $LEVEL_RESTORE_GROUND [[_boxX]] [[_boxY]]
            LISTSET TILE_OBJ [[LEVEL_TEMP]] 0

            SETVAR _destX [[_boxX]]
            SETVAR _destY [[_boxY]]
            ADD _destX <dx>
            ADD _destY <dy>
            $LIST_1D [[_destX]] [[_destY]] [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
            LISTSET TILE_TYPES [[LEVEL_TEMP]] 2
            LISTSET TILE_OBJ [[LEVEL_TEMP]] [[_rid]]

            JUMPLE _rid 0 LEVEL_PUSH_SHIFT_NEXT
            TWEEN3D [[_rid]] "X" [[_boxX]] [[_destX]] false 0.12 "QUAD"
            TWEEN3D [[_rid]] "Y" [[_boxY]] [[_destY]] false 0.12 "QUAD"

        >LEVEL_PUSH_SHIFT_NEXT
            SUB _boxX <dx>
            SUB _boxY <dy>
            SUB _boxCount 1
            JUMP LEVEL_PUSH_SHIFT

    >LEVEL_PUSH_OK
        SETVAR <ok> true
        JUMP LEVEL_PUSH_END

    >LEVEL_PUSH_END
        SETVAR LEVEL_TEMP -1
        BREAK

@LEVEL_FIND_BOX_RAY <x> <y> <dx> <dy> <targetx> <targety> <found>
    SETVAR <found> false
    DEFVAR _rayX <x> int
    DEFVAR _rayY <y> int
    DEFVAR _rayTile 0 int

    >LEVEL_FIND_BOX_RAY_LOOP
        JUMPLT _rayX 0 LEVEL_FIND_BOX_RAY_END
        JUMPLT _rayY 0 LEVEL_FIND_BOX_RAY_END
        JUMPGE _rayX [[LEVEL_W]] LEVEL_FIND_BOX_RAY_END
        JUMPGE _rayY [[LEVEL_H]] LEVEL_FIND_BOX_RAY_END

        $LIST_1D [[_rayX]] [[_rayY]] [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
        LISTGET TILE_TYPES [[LEVEL_TEMP]] _rayTile
        JUMPEQ _rayTile 1 LEVEL_FIND_BOX_RAY_END
        JUMPEQ _rayTile 5 LEVEL_FIND_BOX_RAY_END
        JUMPEQ _rayTile 7 LEVEL_FIND_BOX_RAY_END
        JUMPEQ _rayTile 2 LEVEL_FIND_BOX_RAY_FOUND

        ADD _rayX <dx>
        ADD _rayY <dy>
        JUMP LEVEL_FIND_BOX_RAY_LOOP

    >LEVEL_FIND_BOX_RAY_FOUND
        SETVAR <targetx> [[_rayX]]
        SETVAR <targety> [[_rayY]]
        SETVAR <found> true

    >LEVEL_FIND_BOX_RAY_END
        SETVAR LEVEL_TEMP -1
        BREAK

@LEVEL_PULL <bx> <by> <tx> <ty> <ok>
    SETVAR <ok> false

    JUMPLT <bx> 0 LEVEL_PULL_END
    JUMPLT <by> 0 LEVEL_PULL_END
    JUMPGE <bx> [[LEVEL_W]] LEVEL_PULL_END
    JUMPGE <by> [[LEVEL_H]] LEVEL_PULL_END

    JUMPLT <tx> 0 LEVEL_PULL_END
    JUMPLT <ty> 0 LEVEL_PULL_END
    JUMPGE <tx> [[LEVEL_W]] LEVEL_PULL_END
    JUMPGE <ty> [[LEVEL_H]] LEVEL_PULL_END

    DEFVAR _from 0 int
    DEFVAR _rid 0 int
    $LIST_1D <bx> <by> [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
    LISTGET TILE_TYPES [[LEVEL_TEMP]] _from
    JUMPNEQ _from 2 LEVEL_PULL_END
    LISTGET TILE_OBJ [[LEVEL_TEMP]] _rid

    # dest must be empty or an exit (player is vacating it)
    DEFVAR _to 0 int
    $LIST_1D <tx> <ty> [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
    LISTGET TILE_TYPES [[LEVEL_TEMP]] _to
    JUMPEQ _to 0 LEVEL_PULL_DEST_READY
    JUMPNEQ _to 3 LEVEL_PULL_END

    >LEVEL_PULL_DEST_READY
        # vacate box cell
        $LIST_1D <bx> <by> [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
        $LEVEL_RESTORE_GROUND <bx> <by>
        LISTSET TILE_OBJ [[LEVEL_TEMP]] 0

        # occupy dest
        $LIST_1D <tx> <ty> [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
        LISTSET TILE_TYPES [[LEVEL_TEMP]] 2
        LISTSET TILE_OBJ [[LEVEL_TEMP]] [[_rid]]

        JUMPLE _rid 0 LEVEL_PULL_OK
        TWEEN3D [[_rid]] "X" <bx> <tx> false 0.12 "QUAD" "box_pull_x" false
        TWEEN3D [[_rid]] "Y" <by> <ty> false 0.12 "QUAD" "box_pull_y" false

    >LEVEL_PULL_OK
        SETVAR <ok> true

    >LEVEL_PULL_END
        SETVAR LEVEL_TEMP -1
        BREAK

@LEVEL_SWAP <bx> <by> <px> <py> <ok>
    SETVAR <ok> false

    JUMPLT <bx> 0 LEVEL_SWAP_END
    JUMPLT <by> 0 LEVEL_SWAP_END
    JUMPGE <bx> [[LEVEL_W]] LEVEL_SWAP_END
    JUMPGE <by> [[LEVEL_H]] LEVEL_SWAP_END

    JUMPLT <px> 0 LEVEL_SWAP_END
    JUMPLT <py> 0 LEVEL_SWAP_END
    JUMPGE <px> [[LEVEL_W]] LEVEL_SWAP_END
    JUMPGE <py> [[LEVEL_H]] LEVEL_SWAP_END

    DEFVAR _from 0 int
    DEFVAR _rid 0 int
    $LIST_1D <bx> <by> [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
    LISTGET TILE_TYPES [[LEVEL_TEMP]] _from
    JUMPNEQ _from 2 LEVEL_SWAP_END
    LISTGET TILE_OBJ [[LEVEL_TEMP]] _rid

    # vacate box cell (player will occupy it)
    $LIST_1D <bx> <by> [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
    $LEVEL_RESTORE_GROUND <bx> <by>
    LISTSET TILE_OBJ [[LEVEL_TEMP]] 0

    # place box at player old cell
    $LIST_1D <px> <py> [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
    LISTSET TILE_TYPES [[LEVEL_TEMP]] 2
    LISTSET TILE_OBJ [[LEVEL_TEMP]] [[_rid]]

    JUMPLE _rid 0 LEVEL_SWAP_OK
    EDIT3D [[_rid]] "X" <px>
    EDIT3D [[_rid]] "Y" <py>
    # TWEEN3D [[_rid]] "X" <bx> <px> false 0.12 "QUAD" "box_swap_x" false
    # TWEEN3D [[_rid]] "Y" <by> <py> false 0.12 "QUAD" "box_swap_y" false

    >LEVEL_SWAP_OK
        SETVAR <ok> true

    >LEVEL_SWAP_END
        SETVAR LEVEL_TEMP -1
        BREAK



@LEVEL_NEXT
    $SAVE_MOVE_COUNT [[LEVEL_INDEX]] [[LEVEL_CURRENT_MOVES]]
    ADD LEVEL_INDEX 1
    JUMPGT LEVEL_INDEX LEVEL_COUNT LEVEL_NEXT_WIN

    $LEVEL_LOAD_CURRENT
    JUMP LEVEL_NEXT_DONE

    >LEVEL_NEXT_WIN
        CALL "ON_VICTORY"

    >LEVEL_NEXT_DONE
        BREAK
