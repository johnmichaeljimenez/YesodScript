@LEVEL_RESTORE_GROUND <x> <y>
    $LIST_1D <x> <y> [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP
    DEFVAR _exit_i -1 int
    LISTFIND EXIT_CELLS [[LEVEL_TEMP]] _exit_i
    JUMPLT _exit_i 0 LEVEL_RESTORE_GROUND_FLOOR
    LISTSET TILE_TYPES [[LEVEL_TEMP]] 3
    JUMP LEVEL_RESTORE_GROUND_END

    >LEVEL_RESTORE_GROUND_FLOOR
        LISTSET TILE_TYPES [[LEVEL_TEMP]] 0

    >LEVEL_RESTORE_GROUND_END
        BREAK
