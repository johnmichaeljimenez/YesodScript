# 0 - floor (walkable island tile)
# 1 - wall  (collision only)
# 2 - box   (pushable via LEVEL_PUSH)
# 3 - exit  (walkable goal)
# 4 - yellow switch (pressure plate, tile becomes floor)
# 5 - yellow gate  (closed barrier, opens when every yellow switch is held)
# 6 - purple switch (pressure plate, tile becomes floor)
# 7 - purple gate  (closed barrier, opens when every purple switch is held)

@_INIT
    DEFVAR CUBE_SCALE 0.666666 float

@LEVEL_CLEAR
    CLEAR "level*"
    CLEAR "player*"
    LISTCLEAR TILE_TYPES
    LISTCLEAR EXIT_CELLS
    LISTCLEAR TILE_FLOOR
    LISTCLEAR TILE_OBJ
    LISTCLEAR SWITCH_YELLOW_CELLS
    LISTCLEAR SWITCH_PURPLE_CELLS
    LISTCLEAR GATE_YELLOW_CELLS
    LISTCLEAR GATE_YELLOW_RIDS
    LISTCLEAR GATE_PURPLE_CELLS
    LISTCLEAR GATE_PURPLE_RIDS
    LISTCLEAR LEVEL_SPAWN_XS
    LISTCLEAR LEVEL_SPAWN_YS
    LISTCLEAR LEVEL_SPAWN_HEROES
    SETVAR GATES_YELLOW_OPEN false
    SETVAR GATES_PURPLE_OPEN false
    SETVAR GATES_LETHAL false
    SETVAR LEVEL_W 0
    SETVAR LEVEL_H 0
    SETVAR LEVEL_NAME *
    SETVAR LEVEL_HAS_SPAWN false
    SETVAR LEVEL_SPAWN_X 0
    SETVAR LEVEL_SPAWN_Y 0
    SETVAR LEVEL_SPAWN_HERO 0

@LEVEL_FILL <w> <h>
    SETVAR LEVEL_W <w>
    SETVAR LEVEL_H <h>

    DEFVAR _size <w> int
    MUL _size <h>

    PRINT "LEVEL SIZE [[_size]] ([[LEVEL_W]]x[[LEVEL_H]])"

    $LIST_FILL TILE_TYPES [[_size]] 0
    $LIST_FILL TILE_FLOOR [[_size]] 0
    $LIST_FILL TILE_OBJ [[_size]] 0
    BREAK

@LEVEL_SET <x> <y> <type>
    $LIST_1D <x> <y> [[LEVEL_W]] [[LEVEL_H]] LEVEL_TEMP

    # yellow switch: walkable floor + tracked cell
    JUMPEQ <type> 4 LEVEL_SET_SWITCH_YELLOW
    # yellow gate: closed barrier tile + tracked cell
    JUMPEQ <type> 5 LEVEL_SET_GATE_YELLOW
    # purple switch: walkable floor + tracked cell
    JUMPEQ <type> 6 LEVEL_SET_SWITCH_PURPLE
    # purple gate: closed barrier tile + tracked cell
    JUMPEQ <type> 7 LEVEL_SET_GATE_PURPLE

    LISTSET TILE_TYPES [[LEVEL_TEMP]] <type>
    JUMPEQ <type> 3 LEVEL_SET_EXIT
    BREAK

    >LEVEL_SET_EXIT
        LISTADD EXIT_CELLS [[LEVEL_TEMP]]
        BREAK

    >LEVEL_SET_SWITCH_YELLOW
        LISTSET TILE_TYPES [[LEVEL_TEMP]] 0
        LISTADD SWITCH_YELLOW_CELLS [[LEVEL_TEMP]]
        BREAK

    >LEVEL_SET_GATE_YELLOW
        LISTSET TILE_TYPES [[LEVEL_TEMP]] 5
        LISTADD GATE_YELLOW_CELLS [[LEVEL_TEMP]]
        LISTADD GATE_YELLOW_RIDS 0
        BREAK

    >LEVEL_SET_SWITCH_PURPLE
        LISTSET TILE_TYPES [[LEVEL_TEMP]] 0
        LISTADD SWITCH_PURPLE_CELLS [[LEVEL_TEMP]]
        BREAK

    >LEVEL_SET_GATE_PURPLE
        LISTSET TILE_TYPES [[LEVEL_TEMP]] 7
        LISTADD GATE_PURPLE_CELLS [[LEVEL_TEMP]]
        LISTADD GATE_PURPLE_RIDS 0
        BREAK

@LEVEL_BUILD_VISUALS
    DEFVAR _size [[LEVEL_W]] int
    MUL _size [[LEVEL_H]]

    DEFVAR _i 0 int
    DEFVAR _x 0 int
    DEFVAR _y 0 int
    DEFVAR _type 0 int
    DEFVAR _rid 0 int
    DEFVAR _orid 0 int
    DEFVAR _floors 0 int
    DEFVAR _switch_i -1 int
    DEFVAR _exit_i -1 int
    DEFVAR _gate_i -1 int

    >LEVEL_BUILD_LOOP
        JUMPGE _i [[_size]] LEVEL_BUILD_DONE

        LISTGET TILE_TYPES [[_i]] _type
        # wall=no floor
        JUMPEQ _type 1 LEVEL_BUILD_NEXT

        $LIST_XY [[_i]] [[LEVEL_W]] _x _y

        LISTGET TILE_FLOOR [[_i]] _rid
        JUMPGT _rid 0 LEVEL_BUILD_FLOOR_READY

        RENDER3D [[_x]] [[_y]] 0 "cube" _rid "level_floor"
        EDIT3D [[_rid]] "Scale" [[CUBE_SCALE]]
        LISTSET TILE_FLOOR [[_i]] [[_rid]]
        ADD _floors 1

        >LEVEL_BUILD_FLOOR_READY
            CALL "ON_TILE_FLOOR [[_rid]] [[_x]] [[_y]]"

            # yellow switch plate
            LISTFIND SWITCH_YELLOW_CELLS [[_i]] _switch_i
            JUMPLT _switch_i 0 LEVEL_BUILD_SWITCH_PURPLE
            CALL "ON_TILE_SWITCH [[_rid]] [[_x]] [[_y]] 0"
            JUMP LEVEL_BUILD_AFTER_FLOOR

        >LEVEL_BUILD_SWITCH_PURPLE
            LISTFIND SWITCH_PURPLE_CELLS [[_i]] _switch_i
            JUMPLT _switch_i 0 LEVEL_BUILD_EXIT
            CALL "ON_TILE_SWITCH [[_rid]] [[_x]] [[_y]] 1"
            JUMP LEVEL_BUILD_AFTER_FLOOR

        >LEVEL_BUILD_EXIT
            # Keep the exit visible even when a box starts on it.
            LISTFIND EXIT_CELLS [[_i]] _exit_i
            JUMPLT _exit_i 0 LEVEL_BUILD_AFTER_FLOOR
            CALL "ON_TILE_EXIT [[_rid]] [[_x]] [[_y]]"

        >LEVEL_BUILD_AFTER_FLOOR
            # yellow closed gate barrier
            JUMPEQ _type 5 LEVEL_BUILD_GATE_YELLOW
            # purple closed gate barrier
            JUMPEQ _type 7 LEVEL_BUILD_GATE_PURPLE
            JUMP LEVEL_BUILD_BOX

        >LEVEL_BUILD_GATE_YELLOW
            LISTFIND GATE_YELLOW_CELLS [[_i]] _gate_i
            JUMPLT _gate_i 0 LEVEL_BUILD_NEXT

            LISTGET GATE_YELLOW_RIDS [[_gate_i]] _orid
            JUMPGT _orid 0 LEVEL_BUILD_GATE_YELLOW_JUICE

            RENDER3D [[_x]] [[_y]] 1 "cube" _orid "level_gate"
            EDIT3D [[_orid]] "Scale" [[CUBE_SCALE]]
            LISTSET GATE_YELLOW_RIDS [[_gate_i]] [[_orid]]

            >LEVEL_BUILD_GATE_YELLOW_JUICE
                CALL "ON_TILE_GATE [[_orid]] [[_x]] [[_y]] 0 false"
                JUMP LEVEL_BUILD_NEXT

        >LEVEL_BUILD_GATE_PURPLE
            LISTFIND GATE_PURPLE_CELLS [[_i]] _gate_i
            JUMPLT _gate_i 0 LEVEL_BUILD_NEXT

            LISTGET GATE_PURPLE_RIDS [[_gate_i]] _orid
            JUMPGT _orid 0 LEVEL_BUILD_GATE_PURPLE_JUICE

            RENDER3D [[_x]] [[_y]] 1 "cube" _orid "level_gate"
            EDIT3D [[_orid]] "Scale" [[CUBE_SCALE]]
            LISTSET GATE_PURPLE_RIDS [[_gate_i]] [[_orid]]

            >LEVEL_BUILD_GATE_PURPLE_JUICE
                CALL "ON_TILE_GATE [[_orid]] [[_x]] [[_y]] 1 false"
                JUMP LEVEL_BUILD_NEXT

        >LEVEL_BUILD_BOX
            JUMPNEQ _type 2 LEVEL_BUILD_NEXT

            LISTGET TILE_OBJ [[_i]] _orid
            JUMPGT _orid 0 LEVEL_BUILD_BOX_JUICE

            RENDER3D [[_x]] [[_y]] 1 "cube" _orid "level_obj"
            EDIT3D [[_orid]] "Scale" [[CUBE_SCALE]]
            LISTSET TILE_OBJ [[_i]] [[_orid]]

            >LEVEL_BUILD_BOX_JUICE
                CALL "ON_TILE_BOX [[_orid]] [[_x]] [[_y]]"
                JUMP LEVEL_BUILD_NEXT

        >LEVEL_BUILD_NEXT
            ADD _i 1
            JUMP LEVEL_BUILD_LOOP

    >LEVEL_BUILD_DONE
        CALL "LEVEL_UPDATE_GATES"
        BREAK
