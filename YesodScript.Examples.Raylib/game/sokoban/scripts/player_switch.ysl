@PLAYER_SWITCH
    JUMPEQ PLAYER_MOVING true PLAYER_SWITCH_END
    JUMPLE HERO_COUNT 1 PLAYER_SWITCH_END

    DEFVAR _next [[HERO_ACTIVE]] int
    ADD _next 1
    JUMPLT _next [[HERO_COUNT]] PLAYER_SWITCH_LIFT
    SETVAR _next 0

    >PLAYER_SWITCH_LIFT
        $PLAYER_SELECT_INDEX [[_next]]

    >PLAYER_SWITCH_END
        BREAK

@PLAYER_SELECT_TYPE <type>
    JUMPEQ PLAYER_MOVING true PLAYER_SELECT_TYPE_END
    DEFVAR _i 0 int
    DEFVAR _found_type 0 int

    >PLAYER_SELECT_TYPE_LOOP
        JUMPGE _i [[HERO_COUNT]] PLAYER_SELECT_TYPE_END
        LISTGET HERO_TYPES [[_i]] _found_type
        JUMPEQ _found_type <type> PLAYER_SELECT_TYPE_FOUND
        ADD _i 1
        JUMP PLAYER_SELECT_TYPE_LOOP

    >PLAYER_SELECT_TYPE_FOUND
        $PLAYER_SELECT_INDEX [[_i]]

    >PLAYER_SELECT_TYPE_END
        BREAK
