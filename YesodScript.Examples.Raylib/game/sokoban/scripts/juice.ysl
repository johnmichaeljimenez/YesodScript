    BREAK

@ON_HERO_DEATH
    PRINT "ON_HERO_DEATH"
    BREAK

@ON_BOX_DEATH <rid> <x> <y>
    EDIT3D <rid> "Disabled" true
    PRINT "ON_BOX_DEATH <rid> @ <x>,<y>"
    BREAK

@ON_GATE_OPEN <color>
    PRINT "ON_GATE_OPEN color=<color>"
    BREAK

@ON_GATE_CLOSE <color>
    PRINT "ON_GATE_CLOSE color=<color>"
    BREAK

@ON_GATE_SHOW <rid>
    EDIT3D <rid> "Disabled" false
    PRINT "ON_GATE_SHOW <rid>"
    BREAK

@ON_GATE_HIDE <rid>
    EDIT3D <rid> "Disabled" true
    PRINT "ON_GATE_HIDE <rid>"
    BREAK

@ON_EXIT
    PRINT "ON_EXIT"
    BREAK

@ON_VICTORY
    PRINT "ON_VICTORY"
    BREAK

@ON_PUSH
    PRINT "ON_PUSH"
    BREAK

@ON_PULL
    PRINT "ON_PULL"
    BREAK

@ON_SWAP
    PRINT "ON_SWAP"
    BREAK
