@ON_TILE_FLOOR_LOAD <rid> <x> <y>
    DEFVAR _center_x [[LEVEL_W]] float
    SUB _center_x 1
    DIV _center_x 2
    DEFVAR _center_y [[LEVEL_H]] float
    SUB _center_y 1
    DIV _center_y 2

    DEFVAR _dx <x> float
    SUB _dx [[_center_x]]
    MUL _dx [[_dx]]
    DEFVAR _dy <y> float
    SUB _dy [[_center_y]]
    MUL _dy [[_dy]]
    ADD _dx [[_dy]]
    SQRT _dx
    DIV _dx 20

    TWEEN3D <rid> "Z" 0 0.1 true 0.2 "BELL" * * [[_dx]]
    BREAK

@ON_TILE_SWITCH <rid> <x> <y> <color>
    JUMPEQ <color> 1 ON_TILE_SWITCH_PURPLE
    EDIT3D <rid> "Tint.R" 240
    EDIT3D <rid> "Tint.G" 200
    EDIT3D <rid> "Tint.B" 40
    PRINT "ON_TILE_SWITCH yellow <rid> @ <x>,<y>"
    BREAK

    >ON_TILE_SWITCH_PURPLE
        EDIT3D <rid> "Tint.R" 170
        EDIT3D <rid> "Tint.G" 70
        EDIT3D <rid> "Tint.B" 230
        PRINT "ON_TILE_SWITCH purple <rid> @ <x>,<y>"
        BREAK

@ON_TILE_EXIT <rid> <x> <y>
    EDIT3D <rid> "Tint.R" 80
    EDIT3D <rid> "Tint.G" 220
    EDIT3D <rid> "Tint.B" 100
    PRINT "ON_TILE_EXIT <rid> @ <x>,<y>"
    BREAK

@ON_TILE_GATE <rid> <x> <y> <color> <disabled>
    JUMPEQ <color> 1 ON_TILE_GATE_PURPLE
    EDIT3D <rid> "Tint.R" 240
    EDIT3D <rid> "Tint.G" 190
    EDIT3D <rid> "Tint.B" 30
    JUMP ON_TILE_GATE_APPLY

    >ON_TILE_GATE_PURPLE
        EDIT3D <rid> "Tint.R" 180
        EDIT3D <rid> "Tint.G" 50
        EDIT3D <rid> "Tint.B" 220

    >ON_TILE_GATE_APPLY
        EDIT3D <rid> "Disabled" <disabled>
        PRINT "ON_TILE_GATE color=<color> disabled=<disabled> <rid> @ <x>,<y>"
        BREAK

@ON_TILE_BOX <rid> <x> <y>
    EDIT3D <rid> "Tint.R" 255
    EDIT3D <rid> "Tint.G" 140
    EDIT3D <rid> "Tint.B" 40
    PRINT "ON_TILE_BOX <rid> @ <x>,<y>"
    BREAK

@ON_HERO_SPAWN <rid> <type> <x> <y>
    JUMPEQ <type> 0 ON_HERO_SPAWN_WARRIOR
    JUMPEQ <type> 1 ON_HERO_SPAWN_THIEF
    JUMPEQ <type> 2 ON_HERO_SPAWN_WIZARD
    JUMP ON_HERO_SPAWN_DONE

    >ON_HERO_SPAWN_WARRIOR
        EDIT3D <rid> "ModelID" "fuwawa"
        JUMP ON_HERO_VALID

    >ON_HERO_SPAWN_THIEF
        EDIT3D <rid> "ModelID" "mococo"
        JUMP ON_HERO_VALID

    >ON_HERO_SPAWN_WIZARD
        EDIT3D <rid> "ModelID" "bijou"
        JUMP ON_HERO_VALID

    >ON_HERO_VALID
        EDIT3D <rid> "ShaderID" "shaders/character"
        EDIT3D <rid> "Tint.R" 150
        EDIT3D <rid> "Tint.G" 150
        EDIT3D <rid> "Tint.B" 150

    >ON_HERO_SPAWN_DONE
        PRINT "ON_HERO_SPAWN type=<type> <rid> @ <x>,<y>"
        BREAK

@ON_LEVEL_START
    #dolly zoom (-ish)
    TWEENCAM3D "FromY" 1 0 true 2 "QUAD" "CamY"
    TWEENCAM3D "FromZ" 1 0 true 2 "QUAD" "CamZ"
    TWEENCAM3D "Fovy" -10 0 true 2 "QUAD" "CamF"
    
    PLAYSOUND "sfx/level-start"
    $FADE_OUT
    BREAK

@ON_RESTART
    PLAYSOUND "sfx/undo"
    PRINT "ON_RESTART"
    BREAK

@ON_UNDO
    PLAYSOUND "sfx/undo"
    PRINT "ON_UNDO"
    BREAK

@ON_UNDO_EMPTY
    PRINT "ON_UNDO_EMPTY"
    BREAK

@ON_HERO_SELECT <type> <index> <rid>
    PLAYSOUND "sfx/character-select"
    TWEEN3D <rid> "Z" 1 1.1 false 0.2 "SHAKE" "hero_select"
    PRINT "ON_HERO_SELECT type=<type> index=<index> rid=<rid>"
    BREAK

@ON_HERO_SELECT_ALL <selected_index>
    DEFVAR _tint_i 0 int
    DEFVAR _tint_rid 0 int

    >ON_HERO_TINT_LOOP
        JUMPGE _tint_i [[HERO_COUNT]] ON_HERO_TINT_DONE
        LISTGET HERO_RIDS [[_tint_i]] _tint_rid
        JUMPEQ _tint_i <selected_index> ON_HERO_TINT_SELECTED
        EDIT3D [[_tint_rid]] "Tint.R" 150
        EDIT3D [[_tint_rid]] "Tint.G" 150
        EDIT3D [[_tint_rid]] "Tint.B" 150
        JUMP ON_HERO_TINT_NEXT

        >ON_HERO_TINT_SELECTED
            EDIT3D [[_tint_rid]] "Tint.R" 255
            EDIT3D [[_tint_rid]] "Tint.G" 255
            EDIT3D [[_tint_rid]] "Tint.B" 255

        >ON_HERO_TINT_NEXT
            ADD _tint_i 1
            JUMP ON_HERO_TINT_LOOP

    >ON_HERO_TINT_DONE
        BREAK

@ON_HERO_DEATH
    PRINT "ON_HERO_DEATH"
    BREAK

@ON_BOX_DEATH <rid> <x> <y>
    EDIT3D <rid> "Disabled" true
    PRINT "ON_BOX_DEATH <rid> @ <x>,<y>"
    BREAK

@ON_GATE_OPEN <color>
    PRINT "ON_GATE_OPEN color=<color>"
    BREAK

@ON_GATE_CLOSE <color>
    PRINT "ON_GATE_CLOSE color=<color>"
    BREAK

@ON_GATE_SHOW <rid>
    EDIT3D <rid> "Disabled" false
    PRINT "ON_GATE_SHOW <rid>"
    BREAK

@ON_GATE_HIDE <rid>
    EDIT3D <rid> "Disabled" true
    PRINT "ON_GATE_HIDE <rid>"
    BREAK

@ON_EXIT
    TWEENCAM3D "Fovy" 0 -5 true 1.5 "QUAD" "CamF"
    PLAYSOUND "sfx/level-complete"
    WAIT 1
    $FADE_IN
    PRINT "ON_EXIT"
    BREAK

@ON_VICTORY
    SETVAR GAME_COMPLETED true
    SHOW true "HUD_VICTORY"
    PRINT "ON_VICTORY"
    BREAK

@ON_STEP
    PLAYSOUND "sfx/footstep05" 0.2
    PRINT "ON_STEP"
    BREAK

@ON_PUSH
    PRINT "ON_PUSH"
    BREAK

@ON_PULL
    PRINT "ON_PULL"
    BREAK

@ON_SWAP
    PLAYSOUND "sfx/whoosh_1"
    BREAK

@MENU:MOVE <index> <x> <y> <text>
    PLAYSOUND "sfx/ui-select"

@MENU:SELECTED <index> <x> <y> <text>
    PLAYSOUND "sfx/ui-confirm"