@PLAYER_SELECT_INDEX <index>
    JUMPEQ PLAYER_MOVING true PLAYER_SELECT_INDEX_END
    JUMPLT <index> 0 PLAYER_SELECT_INDEX_END
    JUMPGE <index> [[HERO_COUNT]] PLAYER_SELECT_INDEX_END
    JUMPEQ HERO_ACTIVE <index> PLAYER_SELECT_INDEX_END

    LISTSET HERO_XS [[HERO_ACTIVE]] [[px]]
    LISTSET HERO_YS [[HERO_ACTIVE]] [[py]]
    LISTSET HERO_FACES [[HERO_ACTIVE]] [[face_deg]]

    $HERO_PLACE_INACTIVE [[HERO_ACTIVE]]
    $HERO_LIFT_INACTIVE <index>
    CALL "HERO_ACTIVATE <index> true"
    CALL "ON_HERO_SELECT [[HERO_TYPE]] <index>"
    CALL "LEVEL_UPDATE_GATES"

    DEFVAR _dead false bool
    $HERO_CHECK_GATE_DEATH _dead
    JUMPEQ _dead true PLAYER_SELECT_INDEX_DEATH

    DEFVAR _all_exit false bool
    $HERO_CHECK_ALL_ON_EXIT _all_exit
    JUMPEQ _all_exit false PLAYER_SELECT_INDEX_END
    CALL "ON_EXIT"
    $LEVEL_NEXT
    JUMP PLAYER_SELECT_INDEX_END

    >PLAYER_SELECT_INDEX_DEATH
        $HERO_DIE

    >PLAYER_SELECT_INDEX_END
        BREAK
