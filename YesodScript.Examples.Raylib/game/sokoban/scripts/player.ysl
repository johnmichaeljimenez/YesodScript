@_INIT
    DEFVAR character 0 int
    DEFVAR face_deg 0 int
    DEFVAR px 0 int
    DEFVAR py 0 int
    DEFVAR PLAYER_BLOCKED false bool
    DEFVAR PLAYER_TILE 0 int
    DEFVAR PLAYER_MOVING false bool
    DEFVAR HERO_TYPE 0 int
    # 0 = warrior (multi-box push), 1 = thief (pull), 2 = wizard (swap)

    DEFLIST HERO_XS int
    DEFLIST HERO_YS int
    DEFLIST HERO_TYPES int
    DEFLIST HERO_RIDS int
    DEFLIST HERO_FACES int
    DEFVAR HERO_COUNT 0 int
    DEFVAR HERO_ACTIVE 0 int

# Move flow: decide -> UNDO_PUSH (pre-mutation) -> mutate board -> animate hero.
@PLAYER_MOVE <to> <x> <y>
    JUMPEQ PLAYER_MOVING true PLAYER_MOVE_BUSY

    DEFVAR _exit false bool
    DEFVAR _toX [[px]] int
    DEFVAR _toY [[py]] int
    ADD _toX <x>
    ADD _toY <y>

    $HERO_SYNC_INACTIVE

    JUMPEQ HERO_TYPE 2 PLAYER_MOVE_WIZARD_RAY
    JUMP PLAYER_MOVE_STEP

    >PLAYER_MOVE_WIZARD_RAY
        DEFVAR _swap_found false bool
        DEFVAR _swapX [[_toX]] int
        DEFVAR _swapY [[_toY]] int
        $LEVEL_FIND_BOX_RAY [[_toX]] [[_toY]] <x> <y> _swapX _swapY _swap_found
        JUMPEQ _swap_found false PLAYER_MOVE_STEP

        $UNDO_PUSH
        DEFVAR _swap_ok false bool
        $LEVEL_SWAP [[_swapX]] [[_swapY]] [[px]] [[py]] _swap_ok
        JUMPEQ _swap_ok true PLAYER_MOVE_WIZARD_OK
        $UNDO_DROP
        JUMP END

        >PLAYER_MOVE_WIZARD_OK
            SETVAR _toX [[_swapX]]
            SETVAR _toY [[_swapY]]
            SETVAR PLAYER_BLOCKED false
            SETVAR PLAYER_TILE 2
            CALL "ON_SWAP"
            JUMP PLAYER_MOVE_GO

    >PLAYER_MOVE_STEP
        $LEVEL_STEP [[_toX]] [[_toY]] PLAYER_BLOCKED PLAYER_TILE

    >PLAYER_MOVE_READY
        JUMPEQ PLAYER_BLOCKED true PLAYER_MOVE_BLOCKED_CASE
        # free walk (thief may also pull)
        $UNDO_PUSH
        JUMPEQ HERO_TYPE 1 PLAYER_MOVE_THIEF_PULL
        JUMP PLAYER_MOVE_GO

    >PLAYER_MOVE_THIEF_PULL
        DEFVAR _bx [[px]] int
        DEFVAR _by [[py]] int
        SUB _bx <x>
        SUB _by <y>
        DEFVAR _pull_ok false bool
        $LEVEL_PULL [[_bx]] [[_by]] [[px]] [[py]] _pull_ok
        JUMPEQ _pull_ok true PLAYER_MOVE_THIEF_PULL_OK
        JUMP PLAYER_MOVE_GO

        >PLAYER_MOVE_THIEF_PULL_OK
            CALL "ON_PULL"
            JUMP PLAYER_MOVE_GO

    >PLAYER_MOVE_BLOCKED_CASE
        JUMPEQ PLAYER_TILE 2 PLAYER_MOVE_ON_BOX
        JUMP END

    >PLAYER_MOVE_ON_BOX
        JUMPEQ HERO_TYPE 0 PLAYER_MOVE_WARRIOR_PUSH
        JUMP END

    >PLAYER_MOVE_WARRIOR_PUSH
        $UNDO_PUSH
        DEFVAR _push_ok false bool
        $LEVEL_PUSH [[_toX]] [[_toY]] <x> <y> _push_ok
        JUMPEQ _push_ok true PLAYER_MOVE_WARRIOR_OK
        $UNDO_DROP
        JUMP END

        >PLAYER_MOVE_WARRIOR_OK
            CALL "ON_PUSH"
            JUMP PLAYER_MOVE_GO

    >PLAYER_MOVE_GO
        $HERO_SYNC_INACTIVE

        ADD LEVEL_CURRENT_MOVES 1
        SETVAR PLAYER_MOVING true

        TWEEN3D [[character]] "X" [[px]] [[_toX]] false 0.12 "QUAD" "char_x" true
        TWEEN3D [[character]] "Y" [[py]] [[_toY]] false 0.12 "QUAD" "char_y" true
        SETVAR px [[_toX]]
        SETVAR py [[_toY]]
        LISTSET HERO_XS [[HERO_ACTIVE]] [[px]]
        LISTSET HERO_YS [[HERO_ACTIVE]] [[py]]

        JUMPEQ [[face_deg]] <to> PLAYER_MOVE_WAIT
        TWEEN3D [[character]] "Rotation" [[face_deg]] <to> false 0.12 "QUAD" "char_rotate" true
        SETVAR face_deg <to>
        LISTSET HERO_FACES [[HERO_ACTIVE]] [[face_deg]]

        >PLAYER_MOVE_WAIT
            WAIT 0.12
            SETVAR PLAYER_MOVING false
            CALL "LEVEL_UPDATE_GATES"
            DEFVAR _dead false bool
            $HERO_CHECK_GATE_DEATH _dead
            JUMPEQ _dead true TO_DEATH
            $LEVEL_GET [[px]] [[py]] PLAYER_TILE
            $HERO_CHECK_ALL_ON_EXIT _exit
            JUMP END

    >END
        JUMPEQ _exit true TO_EXIT
        BREAK

    >TO_DEATH
        $HERO_DIE
        BREAK

    >TO_EXIT
        CALL "ON_EXIT"
        WAITFRAME
        $LEVEL_NEXT

    >PLAYER_MOVE_BUSY
        BREAK