@_INIT
    DEFVAR LATEST_CONTINUE_LEVEL 1 int
    DEFVAR LATEST_UNLOCKED_LEVEL 1 int
    DEFVAR SAVE_MOVE_INDEX -1 int
    DEFVAR SAVE_MOVE_BEST 0 int

    DEFLIST MOVE_COUNT_ID string
    DEFLIST MOVE_COUNT_AMT int

    REGSAVEVAR "player" LATEST_CONTINUE_LEVEL
    REGSAVEVAR "player" LATEST_UNLOCKED_LEVEL
    REGSAVEVAR "player" MOVE_COUNT_ID
    REGSAVEVAR "player" MOVE_COUNT_AMT

@SAVE <continue> <unlocked>
    SETVAR LATEST_CONTINUE_LEVEL <continue>
    JUMPLE <unlocked> LATEST_UNLOCKED_LEVEL SAVEEND
    SETVAR LATEST_UNLOCKED_LEVEL <unlocked>

    >SAVEEND
        SAVEDATA "player" "save"

@SAVE_MOVE_COUNT <level> <moves>
    LISTFIND MOVE_COUNT_ID <level> SAVE_MOVE_INDEX
    JUMPLT SAVE_MOVE_INDEX 0 SAVE_MOVE_COUNT_NEW

    LISTGET MOVE_COUNT_AMT [[SAVE_MOVE_INDEX]] SAVE_MOVE_BEST
    JUMPLT <moves> SAVE_MOVE_BEST SAVE_MOVE_COUNT_UPDATE
    JUMP SAVE_MOVE_COUNT_END

    >SAVE_MOVE_COUNT_NEW
        LISTADD MOVE_COUNT_ID <level>
        LISTADD MOVE_COUNT_AMT <moves>
        JUMP SAVE_MOVE_COUNT_END

    >SAVE_MOVE_COUNT_UPDATE
        LISTSET MOVE_COUNT_AMT [[SAVE_MOVE_INDEX]] <moves>

    >SAVE_MOVE_COUNT_END
        BREAK

@LOAD
    LOADDATA "player" "save"