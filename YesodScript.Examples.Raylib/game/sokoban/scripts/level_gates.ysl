# Gates of a color open only while every switch of that color is held by a box or hero.
# Opening clears closed-gate tiles (5/7 -> 0). Closing restores empty open cells (0 -> 5/7).
# When a color transitions open -> closed, any box or inactive hero on those gates is destroyed.
# The active player does not occupy the tile grid — empty gate cells seal under them
# (tile becomes 5/7). HERO_CHECK_GATE_DEATH treats that as a crush.

@LEVEL_UPDATE_GATES
    $LEVEL_UPDATE_GATES_COLOR SWITCH_YELLOW_CELLS GATE_YELLOW_CELLS GATE_YELLOW_RIDS GATES_YELLOW_OPEN 5 [[GATES_YELLOW_OPEN]]
    $LEVEL_UPDATE_GATES_COLOR SWITCH_PURPLE_CELLS GATE_PURPLE_CELLS GATE_PURPLE_RIDS GATES_PURPLE_OPEN 7 [[GATES_PURPLE_OPEN]]
    SETVAR LEVEL_TEMP -1
    BREAK