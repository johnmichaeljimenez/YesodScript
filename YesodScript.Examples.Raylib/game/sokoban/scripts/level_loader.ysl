@LEVEL_LOAD_CURRENT
    CALL "LEVELDATA:metadata" LEVEL_LOAD_METADATA_MISSING

    DEFVAR _level_index [[LEVEL_INDEX]] int
    SUB _level_index 1
    DEFVAR _level_name * string
    LISTGET LEVEL_NAMES [[_level_index]] _level_name
    $SAVE [[LEVEL_INDEX]] [[LEVEL_INDEX]]
    $LEVEL_INIT [[_level_name]]
    $UNDO_CLEAR
    JUMP LEVEL_LOAD_CURRENT_END

    >LEVEL_LOAD_METADATA_MISSING
        PRINT "Missing level metadata"

    >LEVEL_LOAD_CURRENT_END
        BREAK