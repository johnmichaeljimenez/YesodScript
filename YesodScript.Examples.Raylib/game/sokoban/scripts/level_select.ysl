@_INIT
    DEFVAR LEVEL_SELECT_PAGE 0 int
    DEFVAR LEVEL_SELECT_MAX 1 int
    DEFVAR LEVEL_SELECT_START 1 int
    DEFVAR LEVEL_SELECT_END 1 int
    DEFVAR LEVEL_SELECT_INDEX 1 int
    DEFVAR LEVEL_SELECT_RESULT 0 int
    DEFVAR LEVEL_SELECT_ACTION 0 int
    DEFVAR LEVEL_SELECT_START_GAME false bool
    DEFLIST LEVEL_SELECT_MENU string
    DEFLIST LEVEL_SELECT_ACTIONS int

@LEVEL_SELECT
    CALL "LEVELDATA:metadata" LEVEL_SELECT_METADATA_MISSING
    $MENU:POSITION 640 360
    SETVAR LEVEL_SELECT_MAX [[LATEST_UNLOCKED_LEVEL]]
    JUMPLT LEVEL_SELECT_MAX 1 LEVEL_SELECT_MINIMUM
    JUMP LEVEL_SELECT_CAP

    >LEVEL_SELECT_MINIMUM
        SETVAR LEVEL_SELECT_MAX 1

    >LEVEL_SELECT_CAP
        JUMPLE LEVEL_SELECT_MAX [[LEVEL_COUNT]] LEVEL_SELECT_START_PAGE
        SETVAR LEVEL_SELECT_MAX [[LEVEL_COUNT]]

    >LEVEL_SELECT_START_PAGE
        SETVAR LEVEL_SELECT_PAGE 0

    >LEVEL_SELECT_BUILD_PAGE
        LISTCLEAR LEVEL_SELECT_MENU
        LISTCLEAR LEVEL_SELECT_ACTIONS

        SETVAR LEVEL_SELECT_START [[LEVEL_SELECT_PAGE]]
        MUL LEVEL_SELECT_START 10
        ADD LEVEL_SELECT_START 1
        SETVAR LEVEL_SELECT_END [[LEVEL_SELECT_START]]
        ADD LEVEL_SELECT_END 9
        JUMPLE LEVEL_SELECT_END [[LEVEL_SELECT_MAX]] LEVEL_SELECT_BUILD_LEVELS
        SETVAR LEVEL_SELECT_END [[LEVEL_SELECT_MAX]]

    >LEVEL_SELECT_BUILD_LEVELS
        SETVAR LEVEL_SELECT_INDEX [[LEVEL_SELECT_START]]

    >LEVEL_SELECT_BUILD_LEVELS_LOOP
        JUMPGT LEVEL_SELECT_INDEX [[LEVEL_SELECT_END]] LEVEL_SELECT_BUILD_NAV
        LISTADD LEVEL_SELECT_MENU "Level [[LEVEL_SELECT_INDEX]]"
        LISTADD LEVEL_SELECT_ACTIONS [[LEVEL_SELECT_INDEX]]
        ADD LEVEL_SELECT_INDEX 1
        JUMP LEVEL_SELECT_BUILD_LEVELS_LOOP

    >LEVEL_SELECT_BUILD_NAV
        JUMPGT LEVEL_SELECT_PAGE 0 LEVEL_SELECT_ADD_PREVIOUS
        JUMP LEVEL_SELECT_CHECK_NEXT

    >LEVEL_SELECT_ADD_PREVIOUS
        LISTADD LEVEL_SELECT_MENU "Previous Page"
        LISTADD LEVEL_SELECT_ACTIONS -1

    >LEVEL_SELECT_CHECK_NEXT
        JUMPLT LEVEL_SELECT_END [[LEVEL_SELECT_MAX]] LEVEL_SELECT_ADD_NEXT
        JUMP LEVEL_SELECT_ADD_BACK

    >LEVEL_SELECT_ADD_NEXT
        LISTADD LEVEL_SELECT_MENU "Next Page"
        LISTADD LEVEL_SELECT_ACTIONS -2

    >LEVEL_SELECT_ADD_BACK
        LISTADD LEVEL_SELECT_MENU "Back"
        LISTADD LEVEL_SELECT_ACTIONS -3
        $MENU LEVEL_SELECT_MENU "LEVEL_SELECT_RESULT"
        JUMPLT LEVEL_SELECT_RESULT 0 LEVEL_SELECT_END
        LISTGET LEVEL_SELECT_ACTIONS [[LEVEL_SELECT_RESULT]] LEVEL_SELECT_ACTION
        JUMPEQ LEVEL_SELECT_ACTION -1 LEVEL_SELECT_PREVIOUS
        JUMPEQ LEVEL_SELECT_ACTION -2 LEVEL_SELECT_NEXT
        JUMPEQ LEVEL_SELECT_ACTION -3 LEVEL_SELECT_END
        $SAVE [[LEVEL_SELECT_ACTION]] [[LATEST_UNLOCKED_LEVEL]]
        SETVAR LEVEL_SELECT_START_GAME true
        BREAK

    >LEVEL_SELECT_PREVIOUS
        SUB LEVEL_SELECT_PAGE 1
        JUMP LEVEL_SELECT_BUILD_PAGE

    >LEVEL_SELECT_NEXT
        ADD LEVEL_SELECT_PAGE 1
        JUMP LEVEL_SELECT_BUILD_PAGE

    >LEVEL_SELECT_METADATA_MISSING
        PRINT "Missing level metadata"
        JUMP LEVEL_SELECT_END

    >LEVEL_SELECT_END
        BREAK