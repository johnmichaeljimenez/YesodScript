@GAME_INIT
	DEFVAR "P2_DZT" 0 int
	DEFVAR "P2_DZB" 0 int
	BREAK

@AI_PADDLE
	JUMPLE BALL_X 420 END

	SETVAR P2_DZT [[P2_Y]]
	SETVAR P2_DZB [[P2_Y]]
	SUB P2_DZT 3
	ADD P2_DZB 3

	JUMPLE [[BALL_Y]] P2_DZT UP
	JUMPGE [[BALL_Y]] P2_DZB DOWN
	JUMP END

>UP
	SUB P2_Y PADDLE_SPEED
	CALL "CLAMP P2_Y [[P2_Y]] 0 [[GAME_HEIGHT]]"
	EDIT [[P2]] "Y" [[P2_Y]]
	JUMP END
>DOWN
	ADD P2_Y PADDLE_SPEED
	CALL "CLAMP P2_Y [[P2_Y]] 0 [[GAME_HEIGHT]]"
	EDIT [[P2]] "Y" [[P2_Y]]
	JUMP END

>END
	BREAK