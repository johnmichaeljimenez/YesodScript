@PADDLE_HIT <player>
    PLAYSOUND "hit"
    JUMPEQ <player> 1 P1
    JUMPEQ <player> 2 P2
    JUMP END
    
>P1
    TWEEN [[P1]] "X" 0 -8 true 0.15 "BELL"
    JUMP END

>P2
    TWEEN [[P2]] "X" 0 8 true 0.15 "BELL"
    JUMP END

@BALL_BOUNCE
    PLAYSOUND "ball-bounce"

@ON_SCORE
    PLAYSOUND "score"

@BUTTON_PRESS <btn>
    PLAYSOUND "ui-press"
    TWEEN <btn> "Opacity" 0 1 false 0.4 "SHAKE"
    WAIT 0.4

>END
    BREAK